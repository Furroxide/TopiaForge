<Project>
  <Target Name="TopiaForgeMapFileInventory" BeforeTargets="GenerateMSBuildEditorConfigFile">
    <ItemGroup>
      <AdditionalFiles Include="$(MSBuildProjectDirectory)/obj/topiaforge-map-survey*.json" />
      <_TopiaForgeMapCandidates Include="@(Content);@(None)" />
      <AdditionalFiles Include="%(_TopiaForgeMapCandidates.FullPath)"
                       Condition="Exists('%(_TopiaForgeMapCandidates.FullPath)') and ('%(_TopiaForgeMapCandidates.CopyToOutputDirectory)' == 'Always' or '%(_TopiaForgeMapCandidates.CopyToOutputDirectory)' == 'PreserveNewest' or '%(_TopiaForgeMapCandidates.CopyToOutputDirectory)' == 'IfDifferent')">
        <TopiaForgeMapPackedPath Condition="'%(_TopiaForgeMapCandidates.TargetPath)' != ''">%(_TopiaForgeMapCandidates.TargetPath)</TopiaForgeMapPackedPath>
        <TopiaForgeMapPackedPath Condition="'%(_TopiaForgeMapCandidates.TargetPath)' == '' and '%(_TopiaForgeMapCandidates.Link)' != ''">%(_TopiaForgeMapCandidates.Link)</TopiaForgeMapPackedPath>
        <TopiaForgeMapPackedPath Condition="'%(_TopiaForgeMapCandidates.TargetPath)' == '' and '%(_TopiaForgeMapCandidates.Link)' == ''">%(_TopiaForgeMapCandidates.Identity)</TopiaForgeMapPackedPath>
      </AdditionalFiles>
    </ItemGroup>
  </Target>
  <!-- Reference-only SDK packages have no lib/ runtime asset. A copied TopiaForge SDK DLL therefore
       means a project added a loose/private reference that would fight the loader-owned runtime. -->
  <Target Name="TopiaForgeRejectCopiedSdkAssemblies"
          AfterTargets="ResolveReferences"
          BeforeTargets="CoreCompile"
          Condition="'$(TopiaForgeSafeProject)' != 'false' and '$(TopiaForgeAllowCopiedSdkAssemblies)' != 'true'">
    <ItemGroup>
      <_TopiaForgeCopiedSdk Include="@(ReferenceCopyLocalPaths)"
                            Condition="$([System.String]::Copy('%(Filename)').StartsWith('TopiaForge.Mods.'))" />
    </ItemGroup>
    <Error Code="TF1003"
           Condition="'@(_TopiaForgeCopiedSdk)' != ''"
           Text="TopiaForge SDK runtime assemblies must not be copied into a mod package: @(_TopiaForgeCopiedSdk->'%(Filename)%(Extension)', ', '). Use the exact TopiaForge reference-only PackageReference generated by 'topiaforge restore'. See https://docs.topiaforge.dev/diagnostics/TF1003" />
  </Target>
</Project>
