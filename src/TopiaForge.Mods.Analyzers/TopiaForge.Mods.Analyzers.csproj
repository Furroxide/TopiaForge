<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>TopiaForge.Mods.Analyzers</AssemblyName>
    <RootNamespace>TopiaForge.Mods.Analyzers</RootNamespace>
    <Version>0.2.0</Version>
    <PackageVersion>0.2.0</PackageVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>0.2.0</InformationalVersion>
    <Description>Build-time safety and manifest diagnostics for TopiaForge V1 mods.</Description>
    <PackageId>TopiaForge.Mods.Analyzers</PackageId>
    <Authors>TopiaForge</Authors>
    <PackageTags>topiaforge;modding;analyzers;devex</PackageTags>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);TOPIAFORGE_ANALYZER</DefineConstants>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS1038: the TF1008 code fix references the workspace assemblies, which only the IDE loads. The compiler
         instantiates the analyzer type alone, and that type references compiler assemblies only. -->
    <NoWarn>$(NoWarn);RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../TopiaForge.ModManager.Core/VersionUtil.cs" Link="VersionUtil.cs" />
    <Compile Include="../TopiaForge.Mods.Worlds/Internal/MapJson.cs" Link="MapJson.cs" />
    <!-- Roslyn supplies these assemblies at analyzer load time. Keep them compile-only. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/TopiaForge.Mods.Analyzers.props"
          Pack="true" PackagePath="buildTransitive/TopiaForge.Mods.Analyzers.props" />
    <None Include="buildTransitive/TopiaForge.Mods.Analyzers.targets"
          Pack="true" PackagePath="buildTransitive/TopiaForge.Mods.Analyzers.targets" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
