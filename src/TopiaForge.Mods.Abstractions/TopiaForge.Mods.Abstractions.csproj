<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TopiaForge.Mods.Abstractions</AssemblyName>
    <RootNamespace>TopiaForge.Mods</RootNamespace>
    <Version>0.1.0-rc.1</Version>
    <PackageVersion>0.1.0-rc.1</PackageVersion>
    <!-- Keep binary binding stable throughout the 0.1 SDK line. Below 1.0.0 SemVer's breaking
         axis is MINOR, so the frozen identity is 0.<minor>.0.0 rather than <major>.0.0.0. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-rc.1</InformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Specialist contracts ship as independently versioned module packages. Keep this
       assembly limited to the always-present authoring/runtime primitives. -->
  <ItemGroup>
    <Compile Remove="Assets.cs" />
    <Compile Remove="BrainQuery.cs" />
    <Compile Remove="CustomWorlds.cs" />
    <Compile Remove="Dialogue.cs" />
    <Compile Remove="GamemodeHost.cs" />
    <Compile Remove="Gamemodes.cs" />
    <Compile Remove="PauseMenu.cs" />
    <Compile Remove="Prompts.cs" />
    <Compile Remove="RobotAgent.cs" />
    <Compile Remove="RobotColor.cs" />
    <Compile Remove="RobotControl.cs" />
    <Compile Remove="RobotEnums.cs" />
    <Compile Remove="RobotInteractions.cs" />
    <Compile Remove="RobotEditing.cs" />
    <Compile Remove="RobotObjectives.cs" />
    <Compile Remove="RobotSpawning.cs" />
    <Compile Remove="RobotTargetFacts.cs" />
    <Compile Remove="Shop.cs" />
    <Compile Remove="SuperhotTimeDriver.cs" />
    <Compile Remove="TextInputBuffer.cs" />
    <Compile Remove="TimeControl.cs" />
    <Compile Remove="Worlds.cs" />
  </ItemGroup>
  <Import Project="..\TopiaForge.Mods.ReferenceOnlyPack.targets" />
</Project>
