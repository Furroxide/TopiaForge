<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Robotopia.Mods.UnityUi</AssemblyName>
    <RootNamespace>Robotopia.Mods.UnityUi</RootNamespace>
    <!--
      Mods bind to this assembly by simple name (ModRuntime.ResolveAssembly), so the
      public API is additive-only within a major version. AssemblyVersion stays pinned
      for all of 1.x; Version/FileVersion move per release.
    -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreFontEngineModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreTextEngineModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextCoreTextEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(RobotopiaManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(RobotopiaManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(RobotopiaManagedDir)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Robotopia.Mods.Abstractions\Robotopia.Mods.Abstractions.csproj" />
  </ItemGroup>

  <!--
    The QuantumWorks brand AssetBundle (TMP font assets + brand sprites) rides inside
    the DLL so assets and code version-lock and no packaging path needs to stage a loose
    file. Built by tools/build-ui-bundle.ps1; the Condition keeps the repo building
    before the bundle's first commit (the kit falls back to OS fonts + procedural
    sprites and logs the tier it resolved).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\quantumworks-ui.bundle" Condition="Exists('Assets\quantumworks-ui.bundle')" LogicalName="Robotopia.Mods.UnityUi.quantumworks-ui.bundle" />
  </ItemGroup>
</Project>
