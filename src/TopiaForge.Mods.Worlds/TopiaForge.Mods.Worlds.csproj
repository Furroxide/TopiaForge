<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TopiaForge.Mods.Worlds</AssemblyName>
    <RootNamespace>TopiaForge.Mods</RootNamespace>
    <Version>1.0.0</Version>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Description>Unity-free TopiaForge world, gamemode, pause, and shop contracts.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" />
    <Compile Include="..\TopiaForge.Mods.Abstractions\CustomWorlds.cs" Link="CustomWorlds.cs" />
    <Compile Include="..\TopiaForge.Mods.Abstractions\PauseMenu.cs" Link="PauseMenu.cs" />
    <Compile Include="..\TopiaForge.Mods.Abstractions\Shop.cs" Link="Shop.cs" />
    <Compile Include="..\TopiaForge.Mods.Abstractions\Worlds.cs" Link="Worlds.cs" />
  </ItemGroup>
  <Import Project="..\TopiaForge.Mods.ReferenceOnlyPack.targets" />
</Project>
