<Project>
  <!-- Links the Unity-free session engine into a host assembly as internal types. Imported by
       TopiaForge.Mods.Testing (the multiplayer test rig) and the multiplayer provider, so both run
       the same engine. See docs/internal/MultiplayerSessionEngine.md. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs"
             Exclude="$(MSBuildThisFileDirectory)bin\**;$(MSBuildThisFileDirectory)obj\**"
             Link="MultiplayerEngine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
