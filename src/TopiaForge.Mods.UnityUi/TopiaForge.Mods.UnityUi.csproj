<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TopiaForge.Mods.UnityUi</AssemblyName>
    <RootNamespace>TopiaForge.Mods.UnityUi</RootNamespace>
    <!--
      Mods bind to this assembly by simple name (ModRuntime.ResolveAssembly), so the
      public API is additive-only within a compatibility line. Below 1.0.0 that line is
      MINOR, not MAJOR, so AssemblyVersion stays pinned for all of 0.1.x;
      Version/FileVersion move per release.
    -->
    <Version>0.1.0-rc.1</Version>
    <PackageVersion>0.1.0-rc.1</PackageVersion>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-rc.1</InformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <!-- Loader-owned renderer implementation; mod authors consume the Unity-free Context.Ui contract. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreFontEngineModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextCoreFontEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextCoreTextEngineModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextCoreTextEngineModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(RobotopiaManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(RobotopiaManagedDir)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="Unity.InputSystem" HintPath="$(RobotopiaManagedDir)\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" />
    <ProjectReference Include="..\TopiaForge.Mods.Worlds\TopiaForge.Mods.Worlds.csproj" />
  </ItemGroup>

  <!--
    The TopiaForge brand AssetBundle (TMP font assets + brand sprites) rides inside
    the DLL so assets and code version-lock and no packaging path needs to stage a loose
    file. Built by `topiaforge unity build-ui-bundle`; the Condition keeps the repo building
    before the bundle's first commit (the kit falls back to OS fonts + procedural
    sprites and logs the tier it resolved).
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\topiaforge-ui.bundle" Condition="Exists('Assets\topiaforge-ui.bundle')" LogicalName="TopiaForge.Mods.UnityUi.topiaforge-ui.bundle" />
  </ItemGroup>

  <!--
    The embedded brand bundle contains redistributable OFL fonts. Keep their
    license texts beside every copied UnityUi assembly so mod packaging can
    carry the notices with standalone .topiaforgemod release assets.
  -->
  <ItemGroup>
    <None Include="..\..\tools\unity-ui-bundle\Assets\Fonts\Audiowide-OFL.txt"
          Link="third_party\TopiaForge.Mods.UnityUi\LICENSES\Audiowide-OFL.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\unity-ui-bundle\Assets\Fonts\Quicksand-OFL.txt"
          Link="third_party\TopiaForge.Mods.UnityUi\LICENSES\Quicksand-OFL.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
