<Project Sdk="Microsoft.NET.Sdk">

  <!-- Offline game-surface extractor. Uses System.Reflection.MetadataLoadContext to read GameCode.dll (and the
       other Managed-dir assemblies the mods reach into) as METADATA ONLY — no Unity runtime, no code execution —
       so it runs on a plain net8.0 machine. It turns the real installed DLLs into a SurfaceSnapshot that the
       Unity-free Surface library then diffs. This project is a dev/CI tool; it is never shipped inside a mod. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Robotopia.GameCompat.Extractor</AssemblyName>
    <RootNamespace>Robotopia.GameCompat.Extractor</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Robotopia.GameCompat.Surface\Robotopia.GameCompat.Surface.csproj" />
  </ItemGroup>

</Project>
