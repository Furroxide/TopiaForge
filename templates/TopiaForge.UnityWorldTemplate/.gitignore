# Unity project .gitignore. This file lives at the Unity project root.
# Paths with a leading slash are anchored to this folder.

/.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# Memory captures and recordings can be large and may contain sensitive data.
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored.
!/[Aa]ssets/**/*.meta

# Autogenerated editor and IDE output.
/.vs/
/.idea/
/.vscode/
/[Aa]ssets/Plugins/Editor/JetBrains*

# Autogenerated VS/MD/Consulo solution and project files.
/ExportedObj/
/.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity generated meta files for ignored binary/debug artifacts.
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash and platform build output.
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Packed Addressables and temporary generated Android assets.
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

.DS_Store
