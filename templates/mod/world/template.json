{
  "id": "world",
  "label": "Custom world mod",
  "description": "Ships a Unity world prefab in an AssetBundle and declares it as a playable world (pairs with a `topiaforge new unity-world` project).",
  "includeUnityCompanion": false,
  "manifestDefaults": {
    "category": "Content",
    "description": "Custom world for Robotopia.",
    "tags": [
      "world",
      "content",
      "custom-world"
    ],
    "capabilities": [
      "asset-bundles",
      "world-service"
    ],
    "dependencies": {
      "io.github.furroxide.topiaforge.worlds": ">=0.1.0-rc.1 <0.2.0"
    },
    "loadAfter": [
      "io.github.furroxide.topiaforge.worlds"
    ],
    "contributions": {
      "worlds": [
        {
          "id": "{{MOD_ID}}.world",
          "name": "{{DISPLAY_NAME}}",
          "description": "A custom Robotopia world.",
          "content": {
            "kind": "bundle",
            "bundle": "AssetBundles/{{BUNDLE_NAME}}.bundle",
            "prefab": "assets/world/world.prefab"
          },
          "transitions": [
            "additive-arena"
          ],
          "spawn": {
            "kind": "authored-marker",
            "markerName": "SpawnPoint"
          },
          "openToAnyCompatible": true
        }
      ],
      "launchTargets": [
        {
          "id": "{{MOD_ID}}.menu",
          "title": "{{DISPLAY_NAME}}",
          "description": "Explore {{DISPLAY_NAME}}.",
          "gamemode": "io.github.furroxide.topiaforge.worlds.freeplay",
          "world": {
            "policy": "fixed",
            "default": "{{MOD_ID}}.world",
            "allowPlayerOverride": false
          },
          "transition": "auto"
        }
      ]
    }
  }
}
