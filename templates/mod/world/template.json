{
  "id": "world",
  "label": "Custom world mod",
  "description": "Ships a Unity world prefab in an AssetBundle and registers it as a playable world (pairs with a `topiaforge new unity-world` project).",
  "includeUnityCompanion": false,
  "manifestDefaults": {
    "category": "Content",
    "description": "Custom world for Robotopia.",
    "tags": ["world", "content", "custom-world"],
    "capabilities": ["asset-bundles", "world-service"],
    "dependencies": {
      "io.github.furroxide.topiaforge.worlds": ">=0.1.0-rc.1 <0.2.0"
    },
    "loadAfter": ["io.github.furroxide.topiaforge.worlds"]
  }
}
