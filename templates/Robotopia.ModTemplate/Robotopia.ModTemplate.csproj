<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="robotopia.dev.props" Condition="Exists('robotopia.dev.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Robotopia.SampleHelloMod</AssemblyName>
    <RootNamespace>Robotopia.SampleHelloMod</RootNamespace>
  </PropertyGroup>

  <!-- The unity-companion folder is a Unity Editor package (UnityEngine/UnityEditor), compiled by Unity, not by
       this .NET mod project. Exclude it from the default source glob so the solution build ignores it. -->
  <ItemGroup>
    <Compile Remove="unity-companion\**\*.cs" />
    <None Remove="unity-companion\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Robotopia.Mods.Abstractions\Robotopia.Mods.Abstractions.csproj" />
  </ItemGroup>
</Project>
