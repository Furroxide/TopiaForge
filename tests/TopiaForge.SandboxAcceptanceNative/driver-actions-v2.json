{
  "schemaVersion": 2,
  "kind": "sandbox-native-driver-actions-v2",
  "targetId": "io.github.furroxide.topiaforge.sandbox.creator.menu",
  "surfaceId": "sandbox-creator-window",
  "geometryOrigin": "bottom-left",
  "maximumStepMilliseconds": 10000,
  "maximumScenarioMilliseconds": 180000,
  "operations": [
    "prepare",
    "begin",
    "capture",
    "advance",
    "unregister-source",
    "request-session-stop",
    "external-write",
    "destroy-borrowed",
    "register-competing-host",
    "unregister-competing-host",
    "control-cue",
    "stop-control-cue",
    "spawn-control-robot",
    "despawn-control-robot",
    "accessibility-high-contrast",
    "accessibility-scale-150",
    "accessibility-reduced-motion",
    "accessibility-reset",
    "cleanup"
  ],
  "actions": {
    "open": [
      {
        "kind": "key",
        "key": "F5"
      }
    ],
    "reopen": [
      {
        "kind": "key",
        "key": "F5"
      }
    ],
    "hide-f5": [
      {
        "kind": "key",
        "key": "F5"
      }
    ],
