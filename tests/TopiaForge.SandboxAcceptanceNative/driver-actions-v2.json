  "scenarios": [
    {
      "id": "routing",
      "cycles": 2,
      "cycleSteps": [
        {
          "cycle": 1,
          "steps": [
            "open",
            "accessibility-high-contrast",
            "accessibility-scale-150",
            "accessibility-reduced-motion",
            "accessibility-reset",
            "focus-next",
            "hide-f5",
            "reopen",
            "duplicate-toggle",
            "end-session"
          ]
        },
        {
          "cycle": 2,
          "steps": [
            "register-competing-host",
            "open",
            "hide-f5",
            "reopen",
            "end-session",
            "unregister-competing-host"
          ]
        }
      ]
    },
    {
      "id": "catalog-editing",
      "cycles": 1,
      "steps": [
        "open",
        "search-nonmatching",
        "filter-robots",
        "filter-all",
        "$catalog",
        "end-session"
      ],
      "inventoryExpansion": {
        "facts": [
          "catalog",
          "robotCatalog"
        ],
        "maximumEntries": 256,
        "perEntry": [
          "spawn-catalog",
          {
            "ifTransformCapability": 1,
            "action": "edit-transform"
          },
          {
            "ifTransformCapability": 2,
            "action": "edit-rotation"
          },
          {
            "ifTransformCapability": 4,
            "action": "edit-scale"
          },
          "duplicate",
          "undo",
          "remove"
        ],
        "rowFact": "actionCatalogRowId",
        "labelFact": "actionCatalogDisplayName"
      }
    },
    {
      "id": "borrowed-robot",
      "cycles": 3,
      "cycleSteps": [
        {
          "cycle": 1,
          "steps": [
            "open",
            "select-borrowed",
            "edit-transform",
            "edit-personality",
            "edit-brain",
            "end-session"
          ]
        },
        {
          "cycle": 2,
          "steps": [
            "open",
            "select-borrowed",
            "edit-transform",
            "edit-personality",
            "external-write",
            "end-session"
          ]
        },
        {
          "cycle": 3,
          "steps": [
            "open",
            "select-borrowed",
            "edit-transform",
            "destroy-borrowed",
            "end-session"
          ]
        }
      ]
    },
    {
      "id": "source-unload",
      "cycles": 2,
      "cycleSteps": [
        {
          "cycle": 1,
          "steps": [
            "open",
            "spawn-prop",
            "duplicate",
            "spawn-character",
            "spawn-control-robot",
            "unregister-source",
            "end-session",
            "despawn-control-robot"
          ]
        },
        {
          "cycle": 2,
          "steps": [
            "open",
            "spawn-prop",
            "run-graph",
            "unregister-source",
            "end-session"
          ]
        }
      ]
    },
    {
      "id": "hide-reopen",
      "cycles": 1,
      "steps": [
        "open",
        "spawn-prop",
        "select-borrowed",
        "edit-transform",
        "run-graph",
        "move-while-visible",
        "hide-close",
        "move-player",
        "camera-hidden",
        "reopen",
        "text-focus",
        "hide-f5",
        "reopen",
        "stop-graph",
        "end-session"
      ]
    },
    {
      "id": "persistence-refusal",
      "cycles": 1,
      "steps": [
        "observe-refusal"
      ]
    },
    {
      "id": "graph-rollback",
      "cycles": 2,
      "cycleSteps": [
        {
          "cycle": 1,
          "steps": [
            "open",
            "spawn-prop",
            "control-cue",
            "run-graph",
            "hide-f5",
            "aim-graph-prop",
            "interact",
            "reopen",
            "stop-graph",
            "stop-control-cue",
            "end-session"
          ]
        },
        {
          "cycle": 2,
          "steps": [
            "open",
            "spawn-prop",
            "stop-before-start",
            "run-graph",
            "stop-graph",
            "run-graph",
            "stop-graph",
            "end-session"
          ]
        }
      ]
    },
    {
      "id": "lifecycle-routes",
      "cycles": 3,
      "cycleSteps": [
        {
          "cycle": 1,
          "steps": [
            "open",
            "spawn-prop",
            "stop-world-session"
          ]
        },
        {
          "cycle": 2,
          "steps": [
            "open",
            "spawn-prop",
            "stop-world-session",
            "toggle-during-transition",
            "move-player"
          ]
        },
        {
          "cycle": 3,
          "steps": [
            "open",
            "spawn-prop",
            "stop-world-session",
            "toggle-in-menu"
          ]
        }
      ],
      "routes": [
        {
          "cycle": 1,
          "operation": "request-session-stop",
          "method": "IWorldSession.StopAsync"
        },
        {
          "cycle": 2,
          "operation": "request-session-stop",
          "method": "IWorldSession.RestartAsync"
        },
        {
          "cycle": 3,
          "operation": "request-session-stop",
          "method": "IWorldSession.ReturnToMainMenuAsync"
        }
      ],
      "freshSessionPerCycle": true
    },
    {
      "id": "ten-cycles",
      "cycles": 10,
      "steps": [
        "open",
        "spawn-prop",
        "select-borrowed",
        "edit-transform",
        "edit-personality",
        "edit-brain",
        "hide-f5",
        "move-player",
        "camera-hidden",
        "reopen",
        "run-graph",
        "stop-graph",
        "end-session"
      ]
    }
  ],
  "unavailable": [
    "native-vehicle",
    "native-global-mutation-bridge",
    "global-mutation-denial-and-revocation: no shipping global mutation bridge",
    "genuine-remote-participant",
    "remote-backend-conversation-completion",
    "package-specific-live-unload: manager disable requires restart; registration disposal is not package unload"
  ],
  "externalEvidenceRequired": [
    "OS input and click geometry against actual widgets",
    "native screenshot observations against reviewed BMP baselines with masks and tolerances",
    "loopback audio with microphone disabled",
    "admitted synthetic persistence allowlist before/during/after",
    "physical device/layout checks under versioned UX rules",
    "human baseline acceptance of screenshots, physical audibility and subjective usability"
  ],
  "maximumCatalogScenarioMilliseconds": 7200000
}
