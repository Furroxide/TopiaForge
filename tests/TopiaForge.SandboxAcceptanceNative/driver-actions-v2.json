        "containerId": "$scroll-1"
      },
      {
        "kind": "click",
        "nodeId": "stop-project"
      }
    ],
    "stop-before-start": [
      {
        "kind": "capture"
      }
    ],
    "aim-graph-prop": [
      {
        "kind": "aim",
        "fact": "aimToGraphProp",
        "maxIterations": 40,
        "gain": 5
      }
    ],
    "interact": [
      {
        "kind": "key",
        "key": "MouseLeft"
      }
    ],
    "end-session": [
      {
        "kind": "click",
