{
  "schemaVersion": 1,
  "kind": "sandbox-native-driver-actions-v1",
  "targetId": "io.github.furroxide.topiaforge.sandbox.creator.menu",
  "surfaceId": "sandbox-creator-window",
  "geometryOrigin": "bottom-left",
  "maximumStepMilliseconds": 10000,
  "maximumScenarioMilliseconds": 180000,
  "operations": [
    "prepare",
    "begin",
    "capture",
    "advance",
    "unregister-source",
    "request-session-stop",
    "cleanup"
  ],
  "actions": {
    "open": [
      {
        "kind": "key",
        "key": "F5"
      }
    ],
    "hide": [
      {
        "kind": "click",
        "surfaceId": "sandbox-creator-window",
        "nodeId": "hide-workbench"
      }
    ],
    "reopen": [
      {
        "kind": "key",
        "key": "F5"
      }
    ],
    "spawn-prop": [
      {
        "kind": "replace-text",
        "nodeId": "catalog-search",
        "text": "Acceptance prop"
      },
      {
        "kind": "select-list-item",
        "nodeId": "catalog-list",
        "itemId": "content:dev.topiaforge.sandbox-acceptance:prop"
      },
      {
        "kind": "click",
        "nodeId": "spawn-selected"
      }
    ],
    "duplicate": [
      {
        "kind": "click",
        "nodeId": "duplicate-selected"
      }
    ],
    "edit-transform": [
      {
        "kind": "click",
        "nodeId": "nudge-up"
      }
    ],
    "select-borrowed": [
      {
        "kind": "click",
        "nodeId": "refresh-native"
      },
      {
        "kind": "select-list-item",
        "nodeId": "roster-list",
        "itemIdFromFact": "borrowedRosterId"
      }
    ],
    "edit-personality": [
      {
        "kind": "replace-text",
        "nodeId": "persona-name",
        "text": "Sandbox acceptance preview"
      },
      {
        "kind": "replace-text",
        "nodeId": "persona-instructions",
        "text": "Synthetic offline fixture persona. Remain dormant."
      },
      {
        "kind": "click",
        "nodeId": "apply-personality"
      }
    ],
    "edit-brain": [
      {
        "kind": "click",
        "nodeId": "brain-dormant"
      }
    ],
    "run-graph": [
      {
        "kind": "select-list-item",
        "nodeId": "project-list",
        "itemIdFromFact": "projectId"
      },
      {
        "kind": "click",
        "nodeId": "load-project"
      },
      {
        "kind": "barrier",
        "minimumFrames": 2
      },
      {
        "kind": "click",
        "nodeId": "run-project"
      }
    ],
    "stop-graph": [
      {
        "kind": "click",
        "nodeId": "stop-project"
      }
    ],
    "end-session": [
      {
        "kind": "click",
        "nodeId": "end-session"
      },
      {
        "kind": "click",
        "surfaceId": "$modal",
        "nodeId": "confirm"
      }
    ],
    "unregister-source": [
      {
        "kind": "request",
        "operation": "unregister-source"
      }
    ],
    "stop-world-session": [
      {
        "kind": "request",
        "operation": "request-session-stop"
      }
    ],
    "observe-refusal": [
      {
        "kind": "capture"
      }
    ],
    "spawn-catalog": [
      {
        "kind": "replace-text",
        "nodeId": "catalog-search",
        "textFromFact": "actionCatalogDisplayName"
      },
      {
        "kind": "select-list-item",
        "nodeId": "catalog-list",
        "itemIdFromFact": "actionCatalogRowId"
      },
      {
        "kind": "click",
        "nodeId": "spawn-selected"
      }
    ],
    "edit-rotation": [
      {
        "kind": "replace-text",
        "nodeId": "rotation-y",
        "text": "0.7071068"
      },
      {
        "kind": "replace-text",
        "nodeId": "rotation-w",
        "text": "0.7071068"
      },
      {
        "kind": "click",
        "nodeId": "apply-transform"
      }
    ],
    "edit-scale": [
      {
        "kind": "replace-text",
        "nodeId": "scale-x",
        "text": "1.25"
      },
      {
        "kind": "replace-text",
        "nodeId": "scale-y",
        "text": "1.25"
      },
      {
        "kind": "replace-text",
        "nodeId": "scale-z",
        "text": "1.25"
      },
      {
        "kind": "click",
        "nodeId": "apply-transform"
      }
    ],
    "remove": [
      {
        "kind": "click",
        "nodeId": "remove-selected"
      },
      {
        "kind": "click",
        "surfaceId": "$modal",
        "nodeId": "confirm"
      }
    ],
    "move-player": [
      {
        "kind": "key",
        "key": "W"
      }
    ]
  },
  "scenarios": [
    {
      "id": "routing",
      "cycles": 1,
      "steps": [
        "open",
        "hide",
        "reopen",
        "end-session"
      ]
    },
    {
      "id": "catalog-editing",
      "cycles": 1,
      "steps": [
        "open",
        "$catalog",
        "end-session"
      ],
      "inventoryExpansion": {
        "facts": [
          "catalog",
          "robotCatalog"
        ],
        "maximumEntries": 256,
        "perEntry": [
          "spawn-catalog",
          {
            "ifTransformCapability": 1,
            "action": "edit-transform"
          },
          {
            "ifTransformCapability": 2,
            "action": "edit-rotation"
          },
          {
            "ifTransformCapability": 4,
            "action": "edit-scale"
          },
          "duplicate",
          "remove",
          "remove"
        ],
        "rowFact": "actionCatalogRowId",
        "labelFact": "actionCatalogDisplayName"
      }
    },
    {
      "id": "borrowed-robot",
      "cycles": 1,
      "steps": [
        "open",
        "select-borrowed",
        "edit-transform",
        "edit-personality",
        "edit-brain",
        "end-session"
      ]
    },
    {
      "id": "source-unload",
      "cycles": 1,
      "steps": [
        "open",
        "spawn-prop",
        "duplicate",
        "unregister-source",
        "end-session"
      ]
    },
    {
      "id": "hide-reopen",
      "cycles": 1,
      "steps": [
        "open",
        "spawn-prop",
        "hide",
        "move-player",
        "reopen",
        "end-session"
      ]
    },
    {
      "id": "persistence-refusal",
      "cycles": 1,
      "steps": [
        "observe-refusal"
      ]
    },
    {
      "id": "graph-rollback",
      "cycles": 1,
      "steps": [
        "open",
        "spawn-prop",
        "run-graph",
        "stop-graph",
        "end-session"
      ]
    },
    {
      "id": "lifecycle-routes",
      "cycles": 3,
      "steps": [
        "open",
        "spawn-prop",
        "stop-world-session"
      ],
      "routes": [
        {
          "cycle": 1,
          "operation": "request-session-stop",
          "method": "IWorldSession.StopAsync"
        },
        {
          "cycle": 2,
          "operation": "request-session-stop",
          "method": "IWorldSession.RestartAsync"
        },
        {
          "cycle": 3,
          "operation": "request-session-stop",
          "method": "IWorldSession.ReturnToMainMenuAsync"
        }
      ],
      "freshSessionPerCycle": true
    },
    {
      "id": "ten-cycles",
      "cycles": 10,
      "steps": [
        "open",
        "spawn-prop",
        "select-borrowed",
        "edit-transform",
        "edit-personality",
        "edit-brain",
        "hide",
        "move-player",
        "reopen",
        "run-graph",
        "stop-graph",
        "end-session"
      ]
    }
  ],
  "unavailable": [
    "native-vehicle",
    "native-global-mutation-bridge",
    "genuine-remote-participant",
    "package-specific-live-unload: manager disable requires restart; registration disposal is not package unload"
  ],
  "externalEvidenceRequired": [
    "OS input and click geometry against actual widgets",
    "native screenshot observations",
    "loopback audio with microphone disabled",
    "admitted synthetic persistence allowlist before/after",
    "physical device/layout checks under versioned UX rules"
  ],
  "maximumCatalogScenarioMilliseconds": 7200000
}
