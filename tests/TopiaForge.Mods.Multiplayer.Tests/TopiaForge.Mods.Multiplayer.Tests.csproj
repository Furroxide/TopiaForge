<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TopiaForge.Mods.Multiplayer.Tests</AssemblyName>
    <RootNamespace>TopiaForge.Mods.Multiplayer.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- The provider links the engine too; an alias keeps its internal engine types from colliding with the
         compile-check assembly's. Tests reach provider types through `extern alias provider`. -->
    <ProjectReference Include="..\..\mods\TopiaForge.Multiplayer\TopiaForge.Multiplayer.csproj" Aliases="provider" />
    <ProjectReference Include="..\..\samples\multiplayer\TopiaForge.Multiplayer.CounterSample\TopiaForge.Multiplayer.CounterSample.csproj" />
    <ProjectReference Include="..\..\samples\multiplayer\TopiaForge.Multiplayer.DroneSample\TopiaForge.Multiplayer.DroneSample.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Multiplayer\TopiaForge.Mods.Multiplayer.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Testing\TopiaForge.Mods.Testing.csproj" />
    <!-- The compile-check engine assembly grants this harness its internals for the white-box tests. -->
    <ProjectReference Include="..\..\src\TopiaForge.Multiplayer.Engine\TopiaForge.Multiplayer.Engine.csproj" />
    <!-- ModManager's multiplayer composition root is Unity-free; compiling it here lets the real runtime host and
         admission planner drive real providers over the virtual network. -->
    <ProjectReference Include="..\..\src\TopiaForge.ModManager.Core\TopiaForge.ModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerRuntime.cs" Link="Runtime\MultiplayerRuntime.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerRuntime.Realm.cs" Link="Runtime\MultiplayerRuntime.Realm.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerRealm.cs" Link="Runtime\MultiplayerRealm.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerSpawnLedger.cs" Link="Runtime\MultiplayerSpawnLedger.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerRuntimeHost.cs" Link="Runtime\MultiplayerRuntimeHost.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerContentInventory.cs" Link="Runtime\MultiplayerContentInventory.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerContentAdmission.cs" Link="Runtime\MultiplayerContentAdmission.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerDiagnosticRedactor.cs" Link="Runtime\MultiplayerDiagnosticRedactor.cs" />
    <!-- The network world (WS3.6) over the real provider: its Unity-free half, the replication seam it plugs into, and
         the fake engine the ModManager and ModRuntime harnesses share. -->
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerReplication.cs" Link="Runtime\MultiplayerReplication.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\MultiplayerMicrophoneArbiter.cs" Link="Runtime\MultiplayerMicrophoneArbiter.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\RuntimeReplication.cs" Link="Runtime\RuntimeReplication.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\UnityMainThreadGuard.cs" Link="Runtime\UnityMainThreadGuard.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\Multiplayer\World\*.cs" Link="Runtime\World\%(Filename)%(Extension)" />
    <Compile Include="..\TopiaForge.ModRuntime.Tests\FakeWorldScene.cs" Link="World\FakeWorldScene.cs" />
  </ItemGroup>
</Project>
