{
  "$schema": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.mod.schema.json",
  "schemaVersion": 6,
  "name": "dev.topiaforge.multiplayer-acceptance",
  "displayName": "Multiplayer Acceptance",
  "version": "0.2.0",
  "author": { "name": "TopiaForge" },
  "description": "Non-distributable session observations and manual checks for isolated test hosts.",
  "entryAssembly": "TopiaForge.MultiplayerAcceptanceMod.dll",
  "entryType": "TopiaForge.MultiplayerAcceptance.MultiplayerAcceptanceMod",
  "dependencies": {
    "io.github.furroxide.topiaforge.multiplayer": "0.2.0",
    "io.github.furroxide.topiaforge.worlds": ">=0.2.0 <0.3.0"
  },
  "supportedGameVersionRange": ">=0.0.2545 <0.0.2600",
  "supportedLoaderVersionRange": ">=0.2.0 <0.3.0",
  "supportedSdkVersionRange": ">=0.2.0 <0.3.0",
  "platforms": ["windows"],
  "architectures": ["x64"],
  "contentTargets": ["code"],
  "license": "AGPL-3.0-or-later",
  "licenseFiles": ["LICENSE"],
  "capabilities": ["hud", "input", "world-service"],
  "multiplayer": {
    "mode": "session",
    "presence": "required",
    "protocol": { "version": "1.0.0", "peerVersionRange": ">=1.0.0 <2.0.0" },
    "synchronizedFiles": []
  },
  "x-topiaforge-non-distributable": true,
  "contributions": {
    "launchTargets": [{
      "id": "dev.topiaforge.multiplayer-acceptance.session",
      "title": "Multiplayer Acceptance",
      "gamemode": "io.github.furroxide.topiaforge.worlds.freeplay",
      "world": { "policy": "fixed", "default": "io.github.furroxide.topiaforge.worlds.open_sandbox", "allowPlayerOverride": false },
      "transition": "additive-arena"
    }]
  }
}
