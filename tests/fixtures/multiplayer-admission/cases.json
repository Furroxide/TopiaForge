  "cases": [
    {
      "name": "implicit mods with identical packages are admitted and active",
      "policy": "compatible",
      "serverRole": "dedicatedServer",
      "server": {
        "mods": [
          "plain-1.0.0"
        ]
      },
      "client": {
        "mods": [
          "plain-1.0.0"
        ]
      },
      "expect": {
        "admitted": true,
        "activeSessionMods": [
          "example.plain"
        ],
        "mismatches": [],
        "inactiveSessionReasons": []
      }
    },
    {
      "name": "implicit package hashes compare case-insensitively",
      "policy": "compatible",
      "serverRole": "dedicatedServer",
      "server": {
        "mods": [
          "plain-1.0.0"
        ]
      },
      "client": {
        "mods": [
          "plain-1.0.0-upper-hash"
        ]
      },
      "expect": {
        "admitted": true,
        "activeSessionMods": [
          "example.plain"
        ],
        "mismatches": [],
        "inactiveSessionReasons": []
      }
    },
    {
      "name": "an implicit mod at another version blocks admission",
      "policy": "compatible",
      "serverRole": "dedicatedServer",
      "server": {
        "mods": [
          "plain-1.0.0"
        ]
      },
      "client": {
        "mods": [
          "plain-1.1.0"
        ]
      },
      "expect": {
        "admitted": false,
        "activeSessionMods": [],
        "mismatches": [
          {
            "code": "implicitSharedContentMismatch",
            "modId": "example.plain",
            "message": "Implicitly shared mods must be the identical package on every peer.",
            "serverValue": "1.0.0@aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "clientValue": "1.1.0@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
          }
        ],
        "inactiveSessionReasons": []
      }
    },
    {
      "name": "a host's implicit mod is required of every client",
      "policy": "compatible",
      "serverRole": "dedicatedServer",
      "server": {
        "mods": [
          "plain-1.0.0"
        ]
      },
      "client": {
        "mods": []
      },
      "expect": {
        "admitted": false,
        "activeSessionMods": [],
        "mismatches": [
          {
            "code": "missingRequiredMod",
            "modId": "example.plain",
            "message": "The server requires this implicitly shared mod on every client as the identical package.",
            "serverValue": "implicit",
            "clientValue": "absent"
          }
        ],
        "inactiveSessionReasons": []
      }
    },
    {
      "name": "a client's implicit mod must also be enabled on the server",
      "policy": "compatible",
      "serverRole": "dedicatedServer",
      "server": {
        "mods": []
      },
      "client": {
        "mods": [
          "plain-1.0.0"
        ]
      },
      "expect": {
        "admitted": false,
        "activeSessionMods": [],
        "mismatches": [
          {
            "code": "missingRequiredMod",
            "modId": "example.plain",
            "message": "The client enables this implicitly shared mod, so the server must enable the identical package.",
            "serverValue": "absent",
            "clientValue": "implicit"
          }
        ],
        "inactiveSessionReasons": []
      }
    },
