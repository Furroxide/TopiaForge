      "name": "TopiaForge"
    },
    "entryAssembly": "Fixture.dll",
    "entryType": "Fixture.Mod",
    "supportedGameVersionRange": "*",
    "supportedLoaderVersionRange": "*",
    "supportedSdkVersionRange": "*",
    "capabilities": [
      "world-service"
    ],
    "contributions": {
      "worlds": [
        {
          "id": "io.github.furroxide.topiaforge.fixture.arena",
          "name": "Arena",
          "content": {
            "kind": "bundle",
            "bundle": "Content/arena.bundle",
            "prefab": "Arena"
          },
          "transitions": [
            "additive-arena"
          ],
          "spawn": {
            "kind": "provider-default"
          }
        },
        {
          "id": "io.github.furroxide.topiaforge.fixture.generated",
          "name": "Generated",
          "content": {
            "kind": "provider",
            "implementation": {
              "assembly": "Fixture.Worlds.dll",
              "type": "Fixture.GeneratedWorld"
            }
          },
          "transitions": [
            "additive-arena",
            "scene-replacement"
          ],
          "spawn": {
            "kind": "authored-marker",
            "markerName": "SpawnPoint"
          },
          "openToAnyCompatible": true
        },
        {
          "id": "io.github.furroxide.topiaforge.fixture.native",
          "name": "Native Scene",
          "content": {
            "kind": "game-scene",
            "sceneName": "Level_01"
          },
          "transitions": [
            "scene-replacement"
          ],
          "spawn": {
            "kind": "provider-default"
          },
          "openTo": [
            "io.github.furroxide.topiaforge.fixture.survival"
          ]
        },
        {
          "id": "io.github.furroxide.topiaforge.fixture.level",
          "name": "Levels",
          "content": {
            "kind": "discovered",
            "implementation": {
              "type": "Fixture.LevelSource"
            }
          },
          "transitions": [
            "scene-replacement"
          ],
          "spawn": {
            "kind": "provider-default"
          }
        }
      ],
      "gamemodes": [
        {
          "id": "io.github.furroxide.topiaforge.fixture.survival",
          "name": "Survival",
          "implementation": {
            "type": "Fixture.SurvivalGamemode"
          }
        }
      ]
    },
