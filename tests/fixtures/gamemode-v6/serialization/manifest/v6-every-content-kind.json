{
  "id": "v6-every-content-kind",
  "channel": "serialization",
  "kind": "manifest-accepts",
  "summary": "All four ways a world's content is obtained, including the discovered family whose id is a prefix rather than a launchable world.",
  "manifest": {
    "$schema": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.mod.v6.schema.json",
    "schemaVersion": 6,
    "name": "io.github.furroxide.topiaforge.fixture",
