{
  "id": "world-outside-a-fixed-policy",
  "channel": "resolution",
  "kind": "launch-resolution",
  "summary": "A fixed policy admits one world. A player override against it is refused rather than quietly ignored, because a launch that lands somewhere the player did not choose is worse than one that does not start.",
  "profile": {
    "packages": [
      {
        "id": "io.github.furroxide.topiaforge.worlds",
        "version": "0.1.0",
        "manifest": {
          "$schema": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.mod.schema.json",
          "schemaVersion": 6,
          "name": "io.github.furroxide.topiaforge.worlds",
          "displayName": "worlds",
          "version": "0.1.0",
          "author": {
            "name": "TopiaForge"
          },
          "entryAssembly": "Fixture.dll",
          "entryType": "Fixture.Mod",
          "supportedGameVersionRange": "*",
          "supportedLoaderVersionRange": "*",
          "supportedSdkVersionRange": "*",
          "capabilities": [
            "world-service"
          ],
          "contributions": {
            "worlds": [
              {
                "id": "io.github.furroxide.topiaforge.worlds.open_sandbox",
                "name": "open_sandbox",
                "content": {
                  "kind": "game-scene",
                  "sceneName": "UgcPlay"
                },
                "transitions": [
                  "additive-arena"
                ],
                "spawn": {
                  "kind": "provider-default"
                },
                "openToAnyCompatible": true
              },
              {
                "id": "io.github.furroxide.topiaforge.worlds.other",
                "name": "other",
                "content": {
                  "kind": "game-scene",
                  "sceneName": "UgcPlay"
                },
                "transitions": [
                  "additive-arena"
                ],
                "spawn": {
                  "kind": "provider-default"
                },
                "openToAnyCompatible": true
              }
            ],
            "gamemodes": [
              {
                "id": "io.github.furroxide.topiaforge.worlds.freeplay",
                "name": "freeplay",
                "implementation": {
                  "type": "Fixture.Gamemode"
                }
              }
            ],
            "launchTargets": [
              {
                "id": "io.github.furroxide.topiaforge.worlds.freeplay.menu",
                "title": "menu",
                "gamemode": "io.github.furroxide.topiaforge.worlds.freeplay",
                "world": {
                  "policy": "fixed",
                  "default": "io.github.furroxide.topiaforge.worlds.open_sandbox"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "request": {
    "targetId": "io.github.furroxide.topiaforge.worlds.freeplay.menu",
    "worldOverride": "io.github.furroxide.topiaforge.worlds.other"
  },
  "expect": {
    "csharp": {
      "outcome": "reject",
      "errorCodes": [
        "worldNotAdmittedByPolicy"
      ]
    },
    "dart": {
      "outcome": "reject",
      "errorCodes": [
        "worldNotAdmittedByPolicy"
      ]
    }
  }
}
