        "worldId": "io.github.furroxide.topiaforge.worlds.open_sandbox",
        "worldInstanceId": "",
        "transition": "additive-arena",
        "resolvedPackages": [
          "io.github.furroxide.topiaforge.worlds@0.1.0",
