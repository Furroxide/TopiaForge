  },
  "expect": {
    "csharp": {
      "outcome": "accept",
      "normalized": {
        "launch": {
          "outcome": "succeeded",
          "code": "none",
          "message": ""
        },
        "calls": [
          "server.start",
          "participant.start",
          "participant.stop",
          "server.stop"
        ],
        "stop": "failed"
      }
    }
  }
}
