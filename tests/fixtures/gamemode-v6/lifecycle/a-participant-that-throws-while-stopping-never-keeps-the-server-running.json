{
  "id": "a-participant-that-throws-while-stopping-never-keeps-the-server-running",
  "channel": "lifecycle",
  "kind": "participant-lifecycle",
  "summary": "A participant whose disposal throws is reported, and the server controller is still disposed after it.",
  "scenario": {
    "role": "host",
    "factory": "participant",
    "serverStart": "succeeds",
    "participantStart": "succeeds",
