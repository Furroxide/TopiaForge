{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/tests/fixtures/gamemode-v6/fixture.schema.json",
  "title": "TopiaForge Gamemode Contract Conformance Fixture",
  "description": "One cross-language conformance case. There is deliberately no 'skip', 'only' or 'runners' field: which runners must execute a case is declared once per channel in index.json, so a case can never quietly exempt itself from one language.",
  "type": "object",
  "required": [
    "id",
    "channel",
    "kind",
    "summary",
    "expect"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Unique within the whole fixture tree, and equal to the file stem."
    },
    "channel": {
      "enum": [
        "serialization",
        "schema",
        "resolution"
      ]
    },
    "kind": {
      "enum": [
        "manifest-accepts",
        "manifest-rejects",
        "manifest-model-rejects",
        "launch-resolution",
        "transport-codec"
      ],
      "description": "Selects the runner's dispatch arm. Both runners dispatch exhaustively with a failing default, so adding a kind here without teaching both runners fails the harness rather than silently skipping."
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 240
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Keyed by runner. index.json's channelRunners decides which keys are required; a missing or extra runner key fails the harness.",
      "properties": {
        "csharp": {
          "$ref": "#/definitions/outcome"
        },
        "dart": {
          "$ref": "#/definitions/outcome"
        }
      }
    },
    "manifest": {
      "type": "object",
      "description": "A whole topiaforge.mod.json document. Required by the manifest kinds; forbidden elsewhere."
    },
    "schemaOutcome": {
      "enum": [
        "accept",
        "reject"
      ]
    },
    "modelMutation": {
      "enum": [
        "empty-contributions",
        "missing-content",
        "missing-spawn",
        "missing-implementation",
        "missing-world",
        "empty-requirements",
        "discovered-family"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages"
      ],
      "properties": {
        "profileId": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/resolutionPackage"
          }
        },
        "disabledPackages": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/resolutionPackage"
          }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "platform": {
              "type": "string"
            },
            "architecture": {
              "type": "string"
            },
            "contentTarget": {
              "type": "string"
            },
            "gameVersion": {
              "type": "string"
            },
            "contentTargets": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "request": {
      "type": "object"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelopes"
      ],
      "properties": {
        "envelopes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "verifyImmutability": {
      "type": "boolean"
    },
    "transport": {
      "enum": [
        "plan",
        "profile",
        "progress",
        "outcome",
        "observation"
      ]
    },
    "payload": {},
    "wireJson": {
      "type": "string"
    },
    "bindings": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "manifest-accepts"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "manifest",
          "schemaOutcome"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "modelMutation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "manifest-rejects"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "manifest",
          "schemaOutcome"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "modelMutation"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "manifest-model-rejects"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "manifest",
          "schemaOutcome",
          "modelMutation"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "launch-resolution"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "profile",
          "request"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "transport-codec"
          }
        }
      },
      "then": {
        "required": [
          "transport"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "manifest"
              ]
            }
          ]
        },
        "oneOf": [
          {
            "required": [
              "payload"
            ]
          },
          {
            "required": [
              "wireJson"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "launch-resolution"
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "request"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "manifest"
              ]
            },
            {
              "required": [
                "schemaOutcome"
              ]
            },
            {
              "required": [
                "transport"
              ]
            },
            {
              "required": [
                "payload"
              ]
            },
            {
              "required": [
                "wireJson"
              ]
            }
          ]
        }
      }
    }
  ],
  "definitions": {
    "outcome": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "errorCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 96
          },
          "description": "Compared as a set, not a prefix or a count. The existing tests/fixtures/manifests corpus compares only the accept/reject verdict; that is what let the two hand-written readers drift."
        },
        "normalized": {
          "type": "object",
          "description": "Deep-equality check on the value the runner produces. What 'produces' means is fixed per kind by both runners."
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "subject",
              "subjectVersion"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "subject": {
                "type": "string"
              },
              "subjectVersion": {
                "type": "string"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "reject"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "normalized"
              ]
            },
            "oneOf": [
              {
                "required": [
                  "errorCodes"
                ]
              },
              {
                "required": [
                  "blocks"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "accept"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "not": {
              "required": [
                "errorCodes"
              ]
            }
          }
        }
      ]
    },
    "resolutionPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifest",
        "schemaOutcome",
        "validation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "manifest": {
          "type": "object"
        },
        "schemaOutcome": {
          "enum": [
            "accept",
            "reject"
          ]
        },
        "validation": {
          "$ref": "#/definitions/outcome"
        }
      }
    }
  }
}
