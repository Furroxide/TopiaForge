<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TopiaForge.ModManager.Tests</AssemblyName>
    <RootNamespace>TopiaForge.ModManager.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup Condition="'$(TestingKitOnly)' != 'true'">
    <Compile Remove="TestingKitFocusedProgram.cs" />
    <ProjectReference Include="..\..\src\TopiaForge.ModManager.Core\TopiaForge.ModManager.Core.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Interop.Unity\TopiaForge.Mods.Interop.Unity.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Chronos\TopiaForge.Mods.Chronos.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Multiplayer\TopiaForge.Mods.Multiplayer.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Prompts\TopiaForge.Mods.Prompts.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.RobotKit\TopiaForge.Mods.RobotKit.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Ugc\TopiaForge.Mods.Ugc.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Worlds\TopiaForge.Mods.Worlds.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Testing\TopiaForge.Mods.Testing.csproj" />
    <!-- Unity-free, GameCode-free game-compat core: lets the offline CI gate (GameCompatTests) diff the checked-in
         binding manifests against the checked-in surface baseline without ever loading the game DLL. -->
    <ProjectReference Include="..\..\src\TopiaForge.GameCompat.Surface\TopiaForge.GameCompat.Surface.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.GameCompat.Extractor\TopiaForge.GameCompat.Extractor.csproj" />
    <ProjectReference Include="..\TopiaForge.ValidTestMod\TopiaForge.ValidTestMod.csproj" />
    <ProjectReference Include="..\TopiaForge.ValidTestMod.Api\TopiaForge.ValidTestMod.Api.csproj" />
    <!-- ModContext's opt-in interop implementation mentions Unity types. Copy only the two reference
         assemblies needed to load that internal type while exercising the manager context off-game. -->
    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="true" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="TopiaForge.RobotopiaManagedDir" Value="$(RobotopiaManagedDir)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestingKitOnly)' == 'true'">
    <!-- Focused sources use core and specialist SDK contracts directly; keep those dependencies explicit
         instead of relying on the testing package's intentionally reference-only transitive graph. -->
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Chronos\TopiaForge.Mods.Chronos.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Multiplayer\TopiaForge.Mods.Multiplayer.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Prompts\TopiaForge.Mods.Prompts.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.RobotKit\TopiaForge.Mods.RobotKit.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Testing\TopiaForge.Mods.Testing.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Ugc\TopiaForge.Mods.Ugc.csproj" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Worlds\TopiaForge.Mods.Worlds.csproj" />
  </ItemGroup>

  <!-- Compile the UGC live-sync mod's Unity-free logic directly into the test assembly so the service state
       machine can be unit-tested on net10.0 without loading the mod's UnityEngine-referencing assembly. Only the
       Unity-free files are included; UgcGameBridge/overlay/mod entry (which touch UnityEngine) are excluded. -->
  <ItemGroup>
    <Compile Include="..\..\mods\Shared\SafeEvent.cs" />
    <Compile Include="..\..\mods\Shared\UgcNoOpLaunchRequest.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcLiveSyncBridge.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcCommandPollGate.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcLiveSyncCommandFile.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcLiveSyncConfig.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcLiveSyncService.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcSnapshotPayloadValidator.cs" />
    <Compile Include="..\..\mods\TopiaForge.UgcLiveSync\UgcLiveSyncStatusFile.cs" />
  </ItemGroup>

  <!-- Same pattern for the OVERRIDE feature: its Unity-free pieces (the RoboAPI wire protocol + JSON, and the
       deterministic decision resolver) compile into the net10.0 test assembly so they can be unit-tested with no
       UnityEngine/RoboAPI backend. The UnityEngine/HttpClient-referencing files (controllers, client, service) are
       excluded. -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.RobotKit\MiniJson.cs" />
    <Compile Include="..\..\mods\TopiaForge.RobotKit\RoboApiProtocol.cs" />
    <Compile Include="..\..\mods\TopiaForge.RobotKit\RoboApiClient.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesConfig.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesConfig.Defaults.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesConfig.Validation.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\OverrideDecision.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ConversationDirector.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesMod.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombieArchetype.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombieEnemy.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Loop.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Waves.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Enemies.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Session.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Health.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Combat.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.Uplink.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesController.ShopHud.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesConversationController.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesConversationController.Ui.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesGameOverPresenter.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesHudPresenter.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesRunUpgrades.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesRuntimeMath.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesShopCatalog.cs" />
    <Compile Include="..\..\mods\TopiaForge.Zombies\ZombiesShopController.cs" />
  </ItemGroup>

  <!-- Unity-free first-party config contracts: defaults, partial deserialization, normalization, and preset
       safety remain executable without loading Unity/GameCode assemblies. -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.GravityGun\GravityGunConfig.cs" />
    <Compile Include="..\..\mods\TopiaForge.GravityGun\GravityGunController.cs" />
    <Compile Include="..\..\mods\TopiaForge.NoFeedbackUrl\NoFeedbackUrlConfig.cs" />
    <Compile Include="..\..\mods\TopiaForge.PerfFixes\PerfFixesConfig.cs" />
    <Compile Include="..\..\mods\TopiaForge.Performance\PerformanceConfig.cs" />
    <Compile Include="..\..\mods\TopiaForge.Performance\PerformancePreset.cs" />
  </ItemGroup>

  <!-- The multi-turn conversation primitive is also Unity-free (it only touches the SDK contracts + the pure prompt
       assembler), so the whole flow is unit-tested on net8.0 against a fake brain service. -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.RobotKit\ConversationPrompt.cs" />
    <Compile Include="..\..\mods\TopiaForge.RobotKit\RobotConversationService.cs" />
  </ItemGroup>

  <!-- The objective layer (per-robot program state machine + named-target registry) is Unity-free too — it only
       drives IRobotAgent intents — so it unit-tests against a fake agent and a fake clock. The sandbox PROGRAM
       director (request shape + deterministic decision/target parse) rides along, mirroring ConversationDirector. -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.RobotKit\ObjectiveRunner.cs" />
    <Compile Include="..\..\mods\TopiaForge.RobotKit\RobotObjectiveService.cs" />
    <Compile Include="..\..\mods\TopiaForge.Sandbox\RobotProgramDirector.cs" />
    <Compile Include="..\..\mods\TopiaForge.Sandbox\SandboxConfig.cs" />
  </ItemGroup>

  <!-- Chronos time-control: lease/logical-state derivation, native-pause ownership, fixedDeltaTime math, and
       turn-order are Unity-free, so they unit-test on net8.0 (SuperhotTimeDriver lives in Abstractions). -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.Chronos\LeaseLifecycle.cs" />
    <Compile Include="..\..\mods\TopiaForge.Chronos\PlayerSuspendCoordinator.cs" />
    <Compile Include="..\..\mods\TopiaForge.Chronos\TimeLease.cs" />
    <Compile Include="..\..\mods\TopiaForge.Chronos\TimeMath.cs" />
    <Compile Include="..\..\mods\TopiaForge.Chronos\TimeScaleOwnership.cs" />
    <Compile Include="..\..\mods\TopiaForge.Chronos\TimeScalePlan.cs" />
    <Compile Include="..\..\mods\TopiaForge.Chronos\TurnOrder.cs" />
  </ItemGroup>

  <!-- Prompt framework registry is Unity-free, so the implementation is compiled directly for fast contract tests. -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.Prompts\PromptOverrideRegistry.cs" />
  </ItemGroup>

  <!-- Worlds routing, fallback safety, owner-event lifetime plumbing, and transition tracking are pure SDK policy;
       compile them directly so these contracts can be regression-tested without loading UnityEngine or GameCode. -->
  <ItemGroup>
    <Compile Include="..\..\mods\TopiaForge.Worlds\OpenSandboxFallbackPolicy.cs" />
    <Compile Include="..\..\mods\TopiaForge.Worlds\OwnerEventSubscription.cs" />
    <Compile Include="..\..\mods\TopiaForge.Worlds\SceneTransitionTracker.cs" />
    <Compile Include="..\..\mods\TopiaForge.Worlds\MainThreadDispatchQueue.cs" />
    <Compile Include="..\..\mods\TopiaForge.Worlds\WorldAutoLoadRouter.cs" />
  </ItemGroup>

  <!-- The manager's scene-transition arbiter is deliberately Unity-free claim bookkeeping, so the real
       implementation is compiled in and unit-tested (SceneCoordinatorTests + the live-sync deferral tests). -->
  <ItemGroup>
    <Compile Include="..\..\src\TopiaForge.ModManager\SceneCoordinator.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModServiceRegistry.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\OwnerBoundModServiceRegistry.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\OwnerModLifetime.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\RuntimeInfo.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\RuntimeCapabilityProbe.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\GameplayContextServices.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\UnityMainThreadGuard.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\UnityTimingServices.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModContext.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModContext.Configuration.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModContext.LocalStorage.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModContext.Files.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModContext.Events.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\OwnerCoreServices.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\InstalledGameVersionReader.cs" />
    <Compile Include="..\..\src\TopiaForge.ModManager\ModAssemblyResolutionCatalog.cs" />
  </ItemGroup>

  <!-- The TopiaForgeUi kit's Core/ folder is its Unity-free island (tokens, scheme resolution, contrast math,
       easing, sprite-coverage math, virtual-list math, window clamp/snap, sorting-band allocation).
       Compiling it here both unit-tests the logic and mechanically enforces that nothing in Core/
       ever grows a UnityEngine dependency (this net10.0 build would fail). -->
  <ItemGroup>
    <Compile Include="..\..\src\TopiaForge.Mods.UnityUi\Core\*.cs" />
    <Compile Include="..\..\src\TopiaForge.Mods.UnityUi\Runtime\TopiaForgeStateFileCodec.cs" />
  </ItemGroup>

  <!-- Unity editor tooling keeps filesystem primitives in Unity-free helpers so adversarial reads and
       rollback behavior remain executable on the ordinary test runner. -->
  <ItemGroup>
    <Compile Include="..\..\templates\TopiaForge.UnityWorldTemplate\Packages\io.github.furroxide.topiaforge.world-companion\Editor\WorldCompanionFileIo.cs" />
    <Compile Include="..\..\templates\TopiaForge.UnityWorldTemplate\Packages\io.github.furroxide.topiaforge.vpm-resolver\Editor\VpmSafeFileReader.cs" />
    <Compile Include="..\..\templates\unity-companion\Packages\io.github.furroxide.topiaforge.ugc-companion\Editor\UgcCompanionSeedFileIo.cs" />
    <Compile Include="..\..\tools\unity-ui-bundle\Assets\Editor\UiSmokeAssemblyFileIo.cs" />
  </ItemGroup>

  <!-- Embed the reviewed SDK contract so the standard offline test gate cannot silently
       skip it because of the caller's current working directory. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.abstractions.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.abstractions.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.robotkit.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.robotkit.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.worlds.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.worlds.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.chronos.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.chronos.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.multiplayer.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.multiplayer.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.prompts.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.prompts.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.ugc.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.ugc.api.txt" />
    <EmbeddedResource Include="..\..\baselines\topiaforge.mods.testing.api.txt"
                      LogicalName="TopiaForge.ModManager.Tests.topiaforge.mods.testing.api.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(TestingKitOnly)' == 'true'">
    <Compile Remove="@(Compile)" />
    <EmbeddedResource Remove="@(EmbeddedResource)" />
    <Compile Include="TestingKitTests*.cs" />
    <Compile Include="TestingKitFocusedProgram.cs" />
  </ItemGroup>
</Project>
