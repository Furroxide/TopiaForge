{
  "$schema": "../schemas/topiaforge.release-policy.schema.json",
  "schemaVersion": 2,
  "toolchains": {
    "dotnetSdk": "10.0.301",
    "dotnetRuntime": "10.0.9",
    "dart": "3.12.2",
    "flutter": "3.44.6",
    "node": "24.18.0",
    "unity": "6000.0.23f1"
  },
  "gameBuild": {
    "id": 2409,
    "metadataFile": ".github/robotopia-game-build.json",
    "requireLatestAtRelease": true
  },
  "projectLicense": {
    "spdxExpression": "AGPL-3.0-or-later",
    "licenseFile": "LICENSE",
    "decisionStatus": "approved"
  },
  "thirdPartyProvenance": [
    "third_party/BepInEx/provenance.json"
  ],
  "versioning": {
    "productVersion": "0.1.0-rc.1",
    "componentVersionsAreIndependent": true,
    "rollback": "none-initial-release"
  },
  "artifactPolicy": {
    "platformArchives": [
      "TopiaForge-windows-x64.zip"
    ],
    "generatedMetadata": [
      "release-bom.json",
      "release-sbom.spdx.json",
      "topiaforge-update-v1.json",
      "topiaforge-update-v1.json.sig",
      "SHA256SUMS"
    ],
    "canonicalEcosystemPayload": true
  },
  "signingIdentities": {},
  "bepInEx": {
    "version": "5.4.23.5",
    "provenanceFile": "third_party/BepInEx/provenance.json",
    "unityDoorstopVersion": "4.5.0",
    "unityDoorstopCommit": "33dab9a6733862eb81869ff08431d9478b28784b"
  },
  "publication": {
    "mode": "admin-staged-auto-publish",
    "allowTagCreation": false,
    "allowAssetReplacement": false,
    "requireImmutableRelease": true,
    "publishAfterProtectedApproval": true
  }
}
