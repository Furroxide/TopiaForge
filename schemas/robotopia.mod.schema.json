{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantumworks.local/schemas/robotopia.mod.schema.json",
  "title": "Robotopia Mod Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "version",
    "author",
    "entryAssembly",
    "entryType"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
    },
    "displayName": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "license": {
      "type": "string",
      "minLength": 1,
      "description": "SPDX license expression. Public registry submissions must use a concrete expression; placeholders such as Unspecified and NOASSERTION are rejected at publication time."
    },
    "licenseFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "Package-relative license or notice files that accompany the declared SPDX expression.",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[. ](?:/|$))[^\\u0000-\\u001F]+$"
      }
    },
    "entryAssembly": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[\\u0000-\\u001F])(?!.*(?:^|/)(?:\\.{1,2}|[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$))(?!.*//).+$"
    },
    "entryType": { "type": "string", "minLength": 1 },
    "vpmDependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
      },
      "additionalProperties": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependency" }
    },
    "optionalDependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependency" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/definitions/conflict" }
    },
    "loadAfter": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
      }
    },
    "supportedGameVersionRange": { "type": "string" },
    "gameVersion": { "type": "string" },
    "supportedLoaderVersionRange": { "type": "string" },
    "supportedSdkVersionRange": { "type": "string" },
    "category": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "icon": { "type": "string" },
    "screenshots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "homepage": { "type": "string" },
    "source": { "type": "string" },
    "hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "worldGamemodes": {
      "type": "array",
      "items": { "$ref": "#/definitions/gamemode" }
    },
    "apiAssemblies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "legacyFolders": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "legacyFiles": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "legacyPackages": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "definitions": {
    "dependency": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
        },
        "version": { "type": "string" },
        "versionRange": { "type": "string" },
        "optional": { "type": "boolean" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
        },
        "version": { "type": "string" },
        "versionRange": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "gamemode": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    }
  }
}
