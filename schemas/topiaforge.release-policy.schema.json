{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.release-policy.schema.json",
  "title": "TopiaForge release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "toolchains", "gameBuild", "projectLicense", "thirdPartyProvenance", "versioning", "artifactPolicy", "signingIdentities", "bepInEx", "publication"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "toolchains": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnetSdk", "dotnetRuntime", "dart", "flutter", "node", "unity"],
      "properties": {
        "dotnetSdk": { "type": "string" },
        "dotnetRuntime": { "type": "string" },
        "dart": { "type": "string" },
        "flutter": { "type": "string" },
        "node": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "unity": { "type": "string" }
      }
    },
    "gameBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "metadataFile", "requireLatestAtRelease"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "metadataFile": { "type": "string", "minLength": 1 },
        "requireLatestAtRelease": { "type": "boolean" }
      }
    },
    "projectLicense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxExpression", "licenseFile", "decisionStatus"],
      "properties": {
        "spdxExpression": { "type": "string", "minLength": 1 },
        "licenseFile": { "type": ["string", "null"] },
        "decisionStatus": { "enum": ["blocked", "approved"] }
      }
    },
    "thirdPartyProvenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "versioning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productVersion", "componentVersionsAreIndependent", "rollback"],
      "properties": {
        "productVersion": { "type": "string" },
        "componentVersionsAreIndependent": { "const": true },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformArchives", "generatedMetadata", "canonicalEcosystemPayload"],
      "properties": {
        "platformArchives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TopiaForge-linux-x64.zip",
              "TopiaForge-macos-universal.zip",
              "TopiaForge-windows-x64.zip"
            ]
          },
          "allOf": [
            { "contains": { "const": "TopiaForge-linux-x64.zip" } },
            { "contains": { "const": "TopiaForge-windows-x64.zip" } }
          ]
        },
        "generatedMetadata": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string" } },
        "canonicalEcosystemPayload": { "const": true }
      }
    },
    "signingIdentities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "windowsCertificateSha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "macosTeamId": {
          "type": "string",
          "pattern": "^[A-Z0-9]{10}$"
        }
      }
    },
    "bepInEx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "provenanceFile", "unityDoorstopVersion", "unityDoorstopCommit"],
      "properties": {
        "version": { "const": "5.4.23.5" },
        "provenanceFile": { "type": "string" },
        "unityDoorstopVersion": { "const": "4.5.0" },
        "unityDoorstopCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowTagCreation", "allowAssetReplacement", "requireImmutableRelease", "publishAfterProtectedApproval"],
      "properties": {
        "mode": { "const": "admin-staged-auto-publish" },
        "allowTagCreation": { "const": false },
        "allowAssetReplacement": { "const": false },
        "requireImmutableRelease": { "const": true },
        "publishAfterProtectedApproval": { "const": true }
      }
    }
  }
}
