{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/quantum-works/main/schemas/robotopia.registry-index.schema.json",
  "title": "Robotopia Mod Registry Index",
  "description": "A static mod registry index consumable by the Robotopia launcher and CLI as a package source. Generate with `robotopia registry index`. Within formatVersion 1 all changes are additive; the top-level key must stay `mods` (a `packages` key would be parsed as a VPM listing).",
  "type": "object",
  "additionalProperties": true,
  "required": ["formatVersion", "mods"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "name": { "type": "string" },
    "generatedAt": { "type": "string" },
    "sourceRepository": { "type": "string" },
    "mods": {
      "type": "array",
      "description": "One entry per mod id: the latest version only. Older versions live in each entry's history array.",
      "items": { "$ref": "#/definitions/mod" }
    }
  },
  "definitions": {
    "mod": {
      "type": "object",
      "additionalProperties": true,
      "required": ["manifest", "downloadUrl", "packageSha256"],
      "properties": {
        "manifest": {
          "$ref": "https://raw.githubusercontent.com/furroxide/quantum-works/main/schemas/robotopia.mod.schema.json"
        },
        "downloadUrl": {
          "type": "string",
          "description": "URL of the .robotopiamod package. Absolute https, or relative to the index location."
        },
        "packageSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changelog": {
          "type": "string",
          "description": "Notes for the latest version, shown by the launcher's update preview."
        },
        "origin": { "type": "string", "enum": ["first-party", "community"] },
        "publishedAt": { "type": "string" },
        "history": {
          "type": "array",
          "description": "Older versions, newest first. Ignored by launchers that only read the flat entry.",
          "items": { "$ref": "#/definitions/historyItem" }
        }
      }
    },
    "historyItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "downloadUrl", "packageSha256"],
      "properties": {
        "version": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "changelog": { "type": "string" },
        "publishedAt": { "type": "string" }
      }
    }
  }
}
