{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.release-bom.schema.json",
  "title": "TopiaForge release bill of materials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "version", "tag", "targetSha", "distributable", "blockingReasons",
    "rollback", "gameBuild", "gameArchives", "toolchains", "license", "codeSigning", "components",
    "vpmPackages", "mods", "excludedDeveloperMods", "expectedArtifactSet", "artifacts",
    "ecosystem", "provenance", "legalInventory"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 2 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "distributable": { "type": "boolean" },
    "blockingReasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "rollback": { "type": "string", "minLength": 1 },
    "gameBuild": { "type": "integer", "minimum": 1 },
    "gameArchives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "mac"],
      "properties": {
        "windows": { "$ref": "#/definitions/gameArchive" },
        "mac": { "$ref": "#/definitions/gameArchive" }
      }
    },
    "toolchains": { "$ref": "#/definitions/versionMap" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxExpression", "decisionStatus", "file", "sha256"],
      "properties": {
        "spdxExpression": { "type": "string", "minLength": 1 },
        "decisionStatus": { "type": "string", "minLength": 1 },
        "file": { "type": ["string", "null"] },
        "sha256": { "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] }
      }
    },
    "codeSigning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionVersion", "platforms"],
      "properties": {
        "exceptionVersion": { "type": ["string", "null"] },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows-x64", "linux-x64", "macos-universal"],
          "properties": {
            "windows-x64": { "$ref": "#/definitions/codeSigningStatus" },
            "linux-x64": { "$ref": "#/definitions/codeSigningStatus" },
            "macos-universal": { "$ref": "#/definitions/codeSigningStatus" }
          }
        }
      }
    },
    "components": { "$ref": "#/definitions/versionMap" },
    "vpmPackages": { "$ref": "#/definitions/versionMap" },
    "mods": { "$ref": "#/definitions/versionMap" },
    "excludedDeveloperMods": { "$ref": "#/definitions/versionMap" },
    "expectedArtifactSet": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/definitions/safeName" }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/fileInventory" }
    },
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "expectedMods", "expectedVpm", "identitySha256", "files", "platformCopies"],
      "properties": {
        "canonical": { "const": true },
        "expectedMods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/safeName" } },
        "expectedVpm": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/safeName" } },
        "identitySha256": { "$ref": "#/definitions/sha256" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pathInventory" } },
        "platformCopies": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["archive", "identitySha256"],
            "properties": {
              "archive": { "$ref": "#/definitions/safeName" },
              "identitySha256": { "$ref": "#/definitions/sha256" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["unity", "bepInEx"],
      "properties": {
        "unity": {
          "type": "object", "additionalProperties": false,
          "required": ["editorVersion", "bundle", "bundleSha256", "manifest", "manifestSha256"],
          "properties": {
            "editorVersion": { "const": "6000.0.23f1" },
            "bundle": { "const": "topiaforge-ui.bundle" },
            "bundleSha256": { "$ref": "#/definitions/sha256" },
            "manifest": { "type": "string", "minLength": 1 },
            "manifestSha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "bepInEx": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "unityDoorstopVersion", "unityDoorstopCommit", "manifest", "manifestSha256", "bundledAssets", "correspondingSource"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "unityDoorstopVersion": { "type": "string", "minLength": 1 },
            "unityDoorstopCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "manifest": { "type": "string", "minLength": 1 },
            "manifestSha256": { "$ref": "#/definitions/sha256" },
            "bundledAssets": { "type": "array", "minItems": 2, "items": { "type": "object" } },
            "correspondingSource": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        }
      }
    },
    "legalInventory": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/pathInventory" }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safeName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
    "versionMap": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "fileInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": { "$ref": "#/definitions/safeName" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "pathInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "gameArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "codeSigningStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "exceptionApplied"],
      "properties": {
        "status": { "enum": ["not-applicable", "trusted", "ad-hoc", "unsigned"] },
        "exceptionApplied": { "type": "boolean" }
      }
    }
  }
}
