{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.release-bom.schema.json",
  "title": "TopiaForge release bill of materials",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "version", "tag", "targetSha", "distributable", "blockingReasons", "readiness",
    "rollback", "gameBuild", "gameArchives", "toolchains", "license", "codeSigning", "components",
    "vpmPackages", "mods", "excludedDeveloperMods", "expectedArtifactSet", "artifacts",
    "ecosystem", "provenance", "legalInventory"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 3 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "distributable": { "type": "boolean" },
    "blockingReasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "readiness": { "$ref": "#/definitions/readiness" },
    "rollback": { "type": "string", "minLength": 1 },
    "gameBuild": { "type": "integer", "minimum": 1 },
    "gameArchives": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows"],
      "properties": {
        "windows": { "$ref": "#/definitions/gameArchive" },
        "mac": { "$ref": "#/definitions/gameArchive" }
      }
    },
    "toolchains": { "$ref": "#/definitions/versionMap" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdxExpression", "decisionStatus", "file", "sha256"],
      "properties": {
        "spdxExpression": { "type": "string", "minLength": 1 },
        "decisionStatus": { "type": "string", "minLength": 1 },
        "file": { "type": ["string", "null"] },
        "sha256": { "oneOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] }
      }
    },
    "codeSigning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exceptionVersion", "platforms"],
      "properties": {
        "exceptionVersion": { "type": ["string", "null"] },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows-x64", "linux-x64"],
          "properties": {
            "windows-x64": { "$ref": "#/definitions/codeSigningStatus" },
            "linux-x64": { "$ref": "#/definitions/codeSigningStatus" },
            "macos-universal": { "$ref": "#/definitions/codeSigningStatus" }
          }
        }
      }
    },
    "components": { "$ref": "#/definitions/versionMap" },
    "vpmPackages": { "$ref": "#/definitions/versionMap" },
    "mods": { "$ref": "#/definitions/versionMap" },
    "excludedDeveloperMods": { "$ref": "#/definitions/versionMap" },
    "expectedArtifactSet": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/definitions/safeName" }
    },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/fileInventory" }
    },
    "ecosystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "expectedMods", "expectedVpm", "identitySha256", "files", "platformCopies"],
      "properties": {
        "canonical": { "const": true },
        "expectedMods": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/safeName" } },
        "expectedVpm": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/safeName" } },
        "identitySha256": { "$ref": "#/definitions/sha256" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pathInventory" } },
        "platformCopies": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["archive", "identitySha256"],
            "properties": {
              "archive": { "$ref": "#/definitions/safeName" },
              "identitySha256": { "$ref": "#/definitions/sha256" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["unity", "bepInEx"],
      "properties": {
        "unity": {
          "type": "object", "additionalProperties": false,
          "required": ["editorVersion", "bundle", "bundleSha256", "manifest", "manifestSha256"],
          "properties": {
            "editorVersion": { "const": "6000.0.23f1" },
            "bundle": { "const": "topiaforge-ui.bundle" },
            "bundleSha256": { "$ref": "#/definitions/sha256" },
            "manifest": { "type": "string", "minLength": 1 },
            "manifestSha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "bepInEx": {
          "type": "object", "additionalProperties": false,
          "required": ["version", "unityDoorstopVersion", "unityDoorstopCommit", "manifest", "manifestSha256", "bundledAssets", "correspondingSource"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "unityDoorstopVersion": { "type": "string", "minLength": 1 },
            "unityDoorstopCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "manifest": { "type": "string", "minLength": 1 },
            "manifestSha256": { "$ref": "#/definitions/sha256" },
            "bundledAssets": { "type": "array", "minItems": 2, "items": { "type": "object" } },
            "correspondingSource": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        }
      }
    },
    "legalInventory": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/definitions/pathInventory" }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding", "path", "schemaPath", "status", "blobSha256", "summary"],
      "properties": {
        "binding": { "const": "git-blob-at-target-sha" },
        "path": { "const": "release/release-readiness.json" },
        "schemaPath": { "const": "schemas/topiaforge.release-readiness-v1.schema.json" },
        "status": { "enum": ["blocked", "ready", "unavailable"] },
        "blobSha256": {
          "oneOf": [
            { "$ref": "#/definitions/sha256" },
            { "type": "null" }
          ]
        },
        "summary": {
          "oneOf": [
            { "$ref": "#/definitions/readinessSummary" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "unavailable" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "blobSha256": { "type": "null" },
              "summary": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "blobSha256": { "$ref": "#/definitions/sha256" },
              "summary": { "$ref": "#/definitions/readinessSummary" }
            }
          }
        }
      ]
    },
    "readinessSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "releaseVersion",
        "targetSha",
        "readinessBlobSha256",
        "status",
        "gates"
      ],
      "properties": {
        "schema": { "const": "topiaforge-release-readiness-summary-v1" },
        "releaseVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "targetSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "readinessBlobSha256": { "$ref": "#/definitions/sha256" },
        "status": { "enum": ["blocked", "ready"] },
        "gates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/definitions/readinessGate" }
        }
      }
    },
    "readinessGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "status", "reviewerRoles", "evidenceIds"],
      "properties": {
        "id": {
          "enum": [
            "P0-CRED-01",
            "P0-IP-01",
            "P0-PRIV-01",
            "P0-TRUST-01",
            "P1-E2E-01",
            "P1-SUPPORT-01",
            "P1-UX-01"
          ]
        },
        "priority": { "enum": ["P0", "P1"] },
        "status": { "enum": ["accepted-risk", "approved", "blocked"] },
        "reasonCode": {
          "enum": [
            "acceptance-evidence-missing",
            "approval-evidence-missing",
            "independent-evidence-missing",
            "ownership-evidence-missing",
            "rotation-evidence-missing"
          ]
        },
        "reviewerRoles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "accessibility-reviewer",
              "backend-owner",
              "credential-owner",
              "external-author-reviewer",
              "external-player-reviewer",
              "incident-owner",
              "ip-trademark-counsel",
              "native-qa",
              "privacy-legal",
              "product-owner",
              "project-owner",
              "registry-owner",
              "release-owner",
              "robotopia-owner",
              "security-intake-owner",
              "security-owner",
              "support-owner"
            ]
          }
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVID-(P0|P1)-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{4}$"
          }
        },
        "acceptedRisk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "decisionEvidenceId"],
          "properties": {
            "scope": {
              "enum": [
                "rc1-independent-player-author-e2e",
                "rc1-native-ux-accessibility",
                "rc1-support-incident-ownership"
              ]
            },
            "decisionEvidenceId": {
              "type": "string",
              "pattern": "^EVID-P1-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{4}$"
            }
          }
        }
      }
    },
    "safeName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
    "versionMap": {
      "type": "object", "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "fileInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": { "$ref": "#/definitions/safeName" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "pathInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "gameArchive": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "codeSigningStatus": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "exceptionApplied"],
      "properties": {
        "status": { "enum": ["not-applicable", "trusted", "ad-hoc", "unsigned"] },
        "exceptionApplied": { "type": "boolean" }
      }
    }
  }
}
