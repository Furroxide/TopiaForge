{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.manual-releases.schema.json",
  "title": "TopiaForge Manual Release Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "manualOnly", "releaseUrl", "platforms"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "formatVersion": { "const": 2 },
    "manualOnly": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" },
    "releaseUrl": { "type": "string", "pattern": "^https://" },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows", "macos", "linux"],
      "properties": {
        "windows": { "$ref": "#/$defs/artifact" },
        "macos": { "$ref": "#/$defs/artifact" },
        "linux": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
