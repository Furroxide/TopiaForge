{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/quantum-works/main/schemas/robotopia.release-catalog.schema.json",
  "title": "Robotopia manual release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "tag", "status", "notesFile", "components", "vpmPackages", "mods", "excludedDeveloperMods", "artifacts"],
        "properties": {
          "version": { "$ref": "#/definitions/semver" },
          "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "status": { "enum": ["blocked", "ready", "published", "withdrawn"] },
          "notesFile": { "type": "string", "minLength": 1 },
          "components": { "$ref": "#/definitions/versionMap" },
          "vpmPackages": { "$ref": "#/definitions/versionMap" },
          "mods": { "$ref": "#/definitions/versionMap" },
          "excludedDeveloperMods": { "$ref": "#/definitions/versionMap" },
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" }
          }
        }
      }
    }
  },
  "definitions": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "versionMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/semver" }
    }
  }
}
