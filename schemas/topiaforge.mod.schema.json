{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.mod.schema.json",
  "title": "TopiaForge Mod Manifest",
  "description": "TopiaForge Manifest V5 for trusted, in-process mods. Multiplayer metadata is optional; absence means standalone-only. Capabilities are disclosure metadata, not a security sandbox.",
  "type": "object",
  "maxProperties": 64,
  "required": [
    "schemaVersion",
    "name",
    "displayName",
    "version",
    "author",
    "entryAssembly",
    "entryType",
    "supportedGameVersionRange",
    "supportedLoaderVersionRange",
    "supportedSdkVersionRange"
  ],
  "properties": {
    "$schema": { "type": "string", "maxLength": 512 },
    "schemaVersion": { "const": 5 },
    "name": { "$ref": "#/definitions/modId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/definitions/semver" },
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "url": { "type": "string", "maxLength": 2048 }
      }
    },
    "description": { "type": "string", "maxLength": 4096 },
    "entryAssembly": { "$ref": "#/definitions/dllPath" },
    "entryType": { "type": "string", "minLength": 1, "maxLength": 512 },
    "dependencies": { "$ref": "#/definitions/dependencyMap" },
    "optionalDependencies": { "$ref": "#/definitions/dependencyMap" },
    "conflicts": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/definitions/conflict" }
    },
    "loadAfter": { "$ref": "#/definitions/orderHints" },
    "loadBefore": { "$ref": "#/definitions/orderHints" },
    "supportedGameVersionRange": { "$ref": "#/definitions/versionRange" },
    "supportedLoaderVersionRange": { "$ref": "#/definitions/versionRange" },
    "supportedSdkVersionRange": { "$ref": "#/definitions/versionRange" },
    "category": { "type": "string", "maxLength": 64 },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "icon": { "$ref": "#/definitions/portablePath" },
    "screenshots": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/portablePath" }
    },
    "homepage": { "type": "string", "maxLength": 2048 },
    "source": { "type": "string", "maxLength": 2048 },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "SPDX license expression. Public registry submissions must use a concrete expression."
    },
    "licenseFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/portablePath" }
    },
    "hashes": {
      "type": "object",
      "maxProperties": 8192,
      "propertyNames": { "$ref": "#/definitions/portablePath" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/capability" }
    },
    "platforms": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["windows", "macos", "linux"] }
    },
    "architectures": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["x64", "arm64"] }
    },
    "contentTargets": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      }
    },
    "builtWith": { "$ref": "#/definitions/builtWith" },
    "worldGamemodes": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/gamemode" }
    },
    "apiAssemblies": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/dllPath" }
    },
    "multiplayer": { "$ref": "#/definitions/multiplayer" }
  },
  "patternProperties": {
    "^x-[A-Za-z0-9_.-]{1,64}$": true
  },
  "additionalProperties": false,
  "definitions": {
    "modId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,63}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "dependencyMap": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "$ref": "#/definitions/modId" },
      "additionalProperties": { "$ref": "#/definitions/versionRange" }
    },
    "orderHints": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/modId" }
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[\\u0000-\\u001F])(?!.*(?:^|/)(?:\\.{1,2}|[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$))(?!.*//).+$"
    },
    "dllPath": {
      "allOf": [
        { "$ref": "#/definitions/portablePath" },
        { "pattern": "\\.[dD][lL][lL]$" }
      ]
    },
    "capability": {
      "enum": [
        "asset-bundles", "filesystem", "filesystem-watch", "harmony-patch", "hud", "input",
        "navigation", "network", "microphone", "particles", "physics", "physics-settings",
        "player-control", "player-token", "prompt-overrides", "quality-settings", "remote-ai",
        "render-settings", "robot-spawning", "scene-management", "speech-to-text", "time",
        "ugc-livesync", "unsafe-native", "world-service"
      ]
    },
    "conflict": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/modId" },
        "versionRange": { "$ref": "#/definitions/versionRange" },
        "reason": { "type": "string", "maxLength": 512 }
      }
    },
    "gamemode": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/modId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "maxLength": 1024 }
      }
    },
    "builtWith": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "sdkVersion": { "$ref": "#/definitions/semver" },
        "loaderVersion": { "$ref": "#/definitions/semver" },
        "gameVersion": { "$ref": "#/definitions/semver" },
        "toolVersion": { "$ref": "#/definitions/semver" }
      }
    },
    "multiplayer": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["client-local", "server-only", "session"] },
        "presence": { "enum": ["required", "optional"] },
        "protocol": { "$ref": "#/definitions/multiplayerProtocol" },
        "synchronizedFiles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/portablePath" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "const": "session" } }
          },
          "then": { "required": ["presence", "protocol"] }
        },
        {
          "if": {
            "required": ["mode"],
            "properties": { "mode": { "enum": ["client-local", "server-only"] } }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["presence"] },
                { "required": ["protocol"] },
                { "required": ["synchronizedFiles"] }
              ]
            }
          }
        }
      ]
    },
    "multiplayerProtocol": {
      "type": "object",
      "required": ["version"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/definitions/semver" },
        "peerVersionRange": { "$ref": "#/definitions/versionRange" }
      }
    }
  }
}
