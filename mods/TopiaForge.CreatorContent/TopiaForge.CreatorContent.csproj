<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import the analyzer's own package props/targets so first-party mods build under exactly the
       MSBuild contract community authors get: CompilerVisibleProperty wiring, manifest AdditionalFiles,
       and the copied-SDK-assembly guard. Drift between the two populations then cannot happen. -->
  <Import Project="..\..\src\TopiaForge.Mods.Analyzers\buildTransitive\TopiaForge.Mods.Analyzers.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TopiaForge.CreatorContent</AssemblyName>
    <RootNamespace>TopiaForge.CreatorContent</RootNamespace>
    <Version>0.1.0-rc.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-rc.1</InformationalVersion>
    <!-- Genuinely native: this mod uses UnityEngine/Harmony by design, so the safe-API rules do not
         apply. Main-thread rules still do - opting out of the safe profile does not leave the game loop. -->
    <TopiaForgeSafeProject>false</TopiaForgeSafeProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.CreatorContent\TopiaForge.Mods.CreatorContent.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Interop.Unity\TopiaForge.Mods.Interop.Unity.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Analyzers\TopiaForge.Mods.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
  <Import Project="..\..\src\TopiaForge.Mods.Analyzers\buildTransitive\TopiaForge.Mods.Analyzers.targets" />
</Project>
