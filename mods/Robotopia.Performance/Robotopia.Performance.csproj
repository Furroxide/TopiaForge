<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Robotopia.Performance</AssemblyName>
    <RootNamespace>Robotopia.Performance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Robotopia.Mods.Abstractions\Robotopia.Mods.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Harmony ships in BepInEx core, not the game's Managed dir. -->
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />

    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(RobotopiaManagedDir)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime" HintPath="$(RobotopiaManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll" Private="false" />
    <!-- GPU Resident Drawer / GPU occlusion-culling types (GPUResidentDrawerMode, GPUResidentDrawer). -->
    <Reference Include="Unity.RenderPipelines.GPUDriven.Runtime" HintPath="$(RobotopiaManagedDir)\Unity.RenderPipelines.GPUDriven.Runtime.dll" Private="false" />
  </ItemGroup>
</Project>
