<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Robotopia.UiGallery</AssemblyName>
    <RootNamespace>Robotopia.UiGallery</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Robotopia.Mods.Abstractions\Robotopia.Mods.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Robotopia.Mods.UnityUi\Robotopia.Mods.UnityUi.csproj" />
  </ItemGroup>

  <!-- Game/Unity assemblies are referenced for compile only (Private=false): they exist at runtime in the
       game's Managed folder. -->
  <ItemGroup>
    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>
</Project>
