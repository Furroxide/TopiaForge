{
  "$schema": "https://raw.githubusercontent.com/furroxide/quantum-works/main/schemas/robotopia.mod.schema.json",
  "schemaVersion": 2,
  "name": "robotopia.perffixes",
  "displayName": "Robotopia Performance Fixes",
  "version": "0.1.0",
