  "entryType": "Robotopia.PerfFixes.PerfFixesMod",
  "vpmDependencies": {},
  "supportedSdkVersionRange": ">=0.1.0 <0.2.0",
  "category": "Performance",
  "tags": [
    "performance",
    "fps",
    "stutter",
    "gc",
    "optimization",
    "harmony"
  ],
  "license": "Unspecified",
  "permissions": [
    "harmony-patch",
    "physics-settings"
  ]
}
