<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import the analyzer's own package props/targets so first-party mods build under exactly the
       MSBuild contract community authors get: CompilerVisibleProperty wiring, manifest AdditionalFiles,
       and the copied-SDK-assembly guard. Drift between the two populations then cannot happen. -->
  <Import Project="..\..\src\TopiaForge.Mods.Analyzers\buildTransitive\TopiaForge.Mods.Analyzers.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TopiaForge.Worlds</AssemblyName>
    <RootNamespace>TopiaForge.Worlds</RootNamespace>
    <Version>0.1.0-rc.1</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-rc.1</InformationalVersion>
    <!-- Genuinely native, and a loader-owned provider: this mod drives UnityEngine and HDRP directly
         and renders through TopiaForgeUi, so the safe-API rules (TF1001/TF1007) do not apply.
         Main-thread rules still do - opting out of the safe profile does not leave the game loop. The
         opt-out is also required by UiKitSourceConventionTests.UnityUiReferencesStayInternal. -->
    <TopiaForgeSafeProject>false</TopiaForgeSafeProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Worlds\TopiaForge.Mods.Worlds.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.UnityUi\TopiaForge.Mods.UnityUi.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Analyzers\TopiaForge.Mods.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Shared clean-room game-reflection helpers (source-linked so the request shape lives in one place). -->
  <ItemGroup>
    <Compile Include="..\Shared\UgcNoOpLaunchRequest.cs" Link="Shared\UgcNoOpLaunchRequest.cs" />
    <Compile Include="..\Shared\SafeEvent.cs" Link="Shared\SafeEvent.cs" />
    <Compile Remove="SceneClaimMatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine" HintPath="$(RobotopiaManagedDir)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(RobotopiaManagedDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(RobotopiaManagedDir)\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.Core.Runtime" HintPath="$(RobotopiaManagedDir)\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime" HintPath="$(RobotopiaManagedDir)\Unity.RenderPipelines.HighDefinition.Runtime.dll" Private="false" />
  </ItemGroup>
  <Import Project="..\..\src\TopiaForge.Mods.Analyzers\buildTransitive\TopiaForge.Mods.Analyzers.targets" />
</Project>
