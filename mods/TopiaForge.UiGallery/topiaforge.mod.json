{
  "$schema": "https://raw.githubusercontent.com/furroxide/TopiaForge/main/schemas/topiaforge.mod.schema.json",
  "schemaVersion": 6,
  "name": "io.github.furroxide.topiaforge.uigallery",
  "displayName": "TopiaForge UI Gallery",
  "version": "0.2.0",
  "author": {
    "name": "TopiaForge"
  },
  "description": "Developer tool for previewing TopiaForgeUi widgets in Paper, HUD, high contrast, and the Survival sample theme. Toggle with F8. Not shipped in releases.",
  "entryAssembly": "TopiaForge.UiGallery.dll",
  "entryType": "TopiaForge.UiGallery.UiGalleryMod",
  "ui": {
    "schema": 1,
    "themes": [
      {
        "id": "survival",
        "definition": "ui/themes/survival.json"
      },
      {
        "id": "preview-art",
        "definition": "ui/themes/preview-art.json"
      }
    ]
  },
  "dependencies": {
    "io.github.furroxide.topiaforge.worlds": ">=0.2.0 <0.3.0"
  },
  "loadAfter": [
    "io.github.furroxide.topiaforge.worlds"
  ],
  "supportedGameVersionRange": ">=0.0.2640 <0.0.2700",
  "supportedLoaderVersionRange": ">=0.2.0 <0.3.0",
  "supportedSdkVersionRange": ">=0.2.0 <0.3.0",
  "category": "DevTool",
  "tags": [
    "dev-only",
    "ui",
    "gallery",
    "sdk"
  ],
  "license": "AGPL-3.0-or-later",
  "licenseFiles": [
    "LICENSE"
  ],
  "capabilities": [
    "hud",
    "input"
  ],
  "multiplayer": {
    "mode": "client-local"
  }
}
