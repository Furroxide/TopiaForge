<Project Sdk="Microsoft.NET.Sdk">
  <!-- Import the analyzer's own package props/targets so first-party mods build under exactly the
       MSBuild contract community authors get: CompilerVisibleProperty wiring, manifest AdditionalFiles,
       and the copied-SDK-assembly guard. Drift between the two populations then cannot happen. -->
  <Import Project="..\..\src\TopiaForge.Mods.Analyzers\buildTransitive\TopiaForge.Mods.Analyzers.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>TopiaForge.UiGallery</AssemblyName>
    <RootNamespace>TopiaForge.UiGallery</RootNamespace>
    <Version>1.0.0-rc.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.1</InformationalVersion>
    <!-- Opted out solely for the loader-owned TopiaForgeUi reference below, which TF1007 forbids to
         ordinary mods and which no capability excuses. This project has no UnityEngine, GameCode, or
         Harmony reference at all - it is the internal QA gallery, not a native mod. The opt-out is
         required by UiKitSourceConventionTests.UnityUiReferencesStayInternal. -->
    <TopiaForgeSafeProject>false</TopiaForgeSafeProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Abstractions\TopiaForge.Mods.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Worlds\TopiaForge.Mods.Worlds.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.UnityUi\TopiaForge.Mods.UnityUi.csproj" Private="false" />
    <ProjectReference Include="..\..\src\TopiaForge.Mods.Analyzers\TopiaForge.Mods.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\src\TopiaForge.Mods.Analyzers\buildTransitive\TopiaForge.Mods.Analyzers.targets" />
</Project>
