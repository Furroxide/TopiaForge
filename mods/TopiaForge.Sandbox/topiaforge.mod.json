  "description": "A safe-SDK creator sandbox for the Open Sandbox arena. Spawn RobotKit robots at the aim point, toggle follow behavior through interactions, pause their programs, undo the latest spawn, or clean the session through commands and the pause companion. All world, input, physics, entity, UI, and teardown work uses TopiaForge V1 services.",
  "entryAssembly": "TopiaForge.Sandbox.dll",
  "entryType": "TopiaForge.Sandbox.SandboxMod",
  "dependencies": {
    "io.github.furroxide.topiaforge.worlds": ">=1.0.0-rc.1 <2.0.0",
    "io.github.furroxide.topiaforge.robotkit": ">=1.0.0-rc.1 <2.0.0"
  },
  "loadAfter": [
    "io.github.furroxide.topiaforge.worlds",
    "io.github.furroxide.topiaforge.robotkit",
    "io.github.furroxide.topiaforge.gravitygun"
  ],
  "supportedGameVersionRange": "0.0.2227",
  "supportedLoaderVersionRange": ">=1.0.0-rc.1 <2.0.0",
  "supportedSdkVersionRange": ">=1.0.0-rc.1 <2.0.0",
