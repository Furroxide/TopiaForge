{
  "schema_version": 2,
  "repository_full_name": "furroxide/TopiaForge",
  "repository_administrators": [
    "furroxide"
  ],
  "release_staging_principal": {
    "login": "furroxide",
    "actor_id": 221987073,
    "type": "User"
  },
  "release_workflow_principal": {
    "login": "github-actions[bot]",
    "actor_id": 41898282,
    "type": "Bot"
  },
  "github_actions_integration_id": 15368,
  "repository_settings": {
    "default_branch": "main",
    "allow_merge_commit": true,
    "allow_squash_merge": true,
    "allow_rebase_merge": false,
    "allow_auto_merge": false,
    "delete_branch_on_merge": false,
    "allow_update_branch": true,
    "merge_commit_title": "PR_TITLE",
    "merge_commit_message": "PR_BODY",
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "has_issues": true,
    "has_projects": true,
    "has_wiki": false,
    "web_commit_signoff_required": false
  },
  "security_and_analysis": {
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "dependabot_security_updates": "disabled"
  },
  "actions": {
    "permissions": {
      "enabled": true,
      "allowed_actions": "selected",
      "sha_pinning_required": true
    },
    "selected_actions": {
      "github_owned_allowed": true,
      "verified_allowed": false,
      "patterns_allowed": [
        "dart-lang/setup-dart@*",
        "subosito/flutter-action@*"
      ]
    },
    "workflow_permissions": {
      "default_workflow_permissions": "read",
      "can_approve_pull_request_reviews": false
    },
    "fork_pr_contributor_approval": {
      "approval_policy": "all_external_contributors"
    }
  },
  "security": {
    "dependabot_alerts": true,
    "automated_security_updates": false,
    "codeql_default_setup": {
      "state": "configured",
      "languages": [
        "actions",
        "c-cpp",
        "csharp",
        "javascript-typescript"
      ],
      "query_suite": "default",
      "schedule": "weekly",
      "runner_type": "standard",
      "threat_model": "remote_and_local"
    },
    "private_vulnerability_reporting": true
  },
  "immutable_releases": {
    "enabled": true
  },
  "forbidden_rulesets": [
    "protected-release-flow",
    "admin-only-release-branches",
    "admin-only-version-tags"
  ],
  "rulesets": [
    {
      "name": "protect-main",
      "target": "branch",
      "enforcement": "active",
      "ref_includes": [
        "~DEFAULT_BRANCH"
      ],
      "bypass_actors": [],
      "rule_types": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_signatures",
        "required_status_checks"
      ],
      "pull_request": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge"
        ]
      },
      "required_status_checks": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "contexts": [
          "Required / PR policy",
          "Required / CI validation",
          "Required / Unity source validation",
          "Required / Registry validation",
          "Required / Dependency review",
          "Required / Release packages"
        ]
      }
    },
    {
      "name": "protect-dev",
      "target": "branch",
      "enforcement": "active",
      "ref_includes": [
        "refs/heads/dev"
      ],
      "bypass_actors": [],
      "rule_types": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_signatures",
        "required_status_checks"
      ],
      "pull_request": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash"
        ]
      },
      "required_status_checks": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "contexts": [
          "Required / PR policy",
          "Required / CI validation",
          "Required / Unity source validation",
          "Required / Registry validation",
          "Required / Dependency review"
        ]
      }
    },
    {
      "name": "protect-release-branches",
      "target": "branch",
      "enforcement": "active",
      "ref_includes": [
        "refs/heads/release/*"
      ],
      "bypass_actors": [],
      "rule_types": [
        "non_fast_forward",
        "pull_request",
        "required_signatures",
        "required_status_checks"
      ],
      "pull_request": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      },
      "required_status_checks": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": true,
        "contexts": [
          "Required / PR policy",
          "Required / CI validation",
          "Required / Unity source validation",
          "Required / Registry validation",
          "Required / Dependency review"
        ]
      }
    },
    {
      "name": "codeql-high-critical",
      "target": "branch",
      "enforcement": "active",
      "ref_includes": [
        "refs/heads/main",
        "refs/heads/dev",
        "refs/heads/release/*"
      ],
      "bypass_actors": [],
      "rule_types": [
        "code_scanning"
      ],
      "code_scanning": {
        "tool": "CodeQL",
        "alerts_threshold": "errors",
        "security_alerts_threshold": "high_or_higher"
      }
    },
    {
      "name": "release-branch-lifecycle",
      "target": "branch",
      "enforcement": "active",
      "ref_includes": [
        "refs/heads/release/*"
      ],
      "bypass_actors": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "always"
        }
      ],
      "rule_types": [
        "creation",
        "deletion"
      ]
    },
    {
      "name": "version-tag-creation",
      "target": "tag",
      "enforcement": "active",
      "ref_includes": [
        "refs/tags/v*"
      ],
      "bypass_actors": [
        {
          "actor_id": 5,
          "actor_type": "RepositoryRole",
          "bypass_mode": "always"
        }
      ],
      "rule_types": [
        "creation"
      ]
    },
    {
      "name": "version-tag-immutability",
      "target": "tag",
      "enforcement": "active",
      "ref_includes": [
        "refs/tags/v*"
      ],
      "bypass_actors": [],
      "rule_types": [
        "deletion",
        "update"
      ]
    }
  ],
  "environments": [
    {
      "name": "release",
      "can_admins_bypass": false,
      "protected_branches": false,
      "custom_branch_policies": true,
      "reviewer_ids": [
        221987073
      ],
      "prevent_self_review": false,
      "branch_policies": [
        {
          "name": "v*",
          "type": "tag"
        }
      ]
    },
    {
      "name": "github-pages",
      "can_admins_bypass": false,
      "protected_branches": false,
      "custom_branch_policies": true,
      "reviewer_ids": [
        221987073
      ],
      "prevent_self_review": false,
      "branch_policies": [
        {
          "name": "v*",
          "type": "tag"
        }
      ]
    }
  ],
  "manual_controls": [
    "Confirm the repository push policy limits each push to five ref updates.",
    "Confirm the sole owner has a passkey or hardware key, TOTP recovery, offline recovery codes, and reviewed sessions, PATs, and SSH keys.",
    "Confirm administrator bypass is disabled in each protected environment if the REST response cannot prove it.",
    "Confirm only explicitly trusted collaborators can submit formal approval or changes-requested reviews.",
    "Confirm DCO enforcement and GitHub web commit signoff are enabled after the v1.0.0-rc.1 cutover tag.",
    "Confirm ordinary dev pull requests use squash merge and sync/main-v* pull requests use a merge commit; GitHub cannot condition a merge method on the source branch."
  ]
}
