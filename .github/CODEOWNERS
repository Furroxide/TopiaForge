# These paths define public trust, release, update, and package contracts.
# Ownership is advisory while TopiaForge has one maintainer. Repository rules
# begin requiring an independent CODEOWNER review only after a second trusted
# maintainer is available.
/.github/ @furroxide
/.gitattributes @furroxide
/.github/CODEOWNERS @furroxide
/.github/workflows/ @furroxide
/.github/dependabot.yml @furroxide
/.github/repository-governance.json @furroxide
/.github/robotopia-game-build.json @furroxide
/.github/scripts/audit_repository_governance.py @furroxide
/.github/scripts/test_audit_repository_governance.py @furroxide
/CONTRIBUTING.md @furroxide
/SECURITY.md @furroxide
/docs/RepositoryGovernance.md @furroxide
/docs/internal/github-governance-* @furroxide
/release/ @furroxide
/schemas/ @furroxide
/registry/ @furroxide

